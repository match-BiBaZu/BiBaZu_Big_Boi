	BatchNextCompleteSequence		: UDINT := 1;
	BatchLastAcceptedCommit			: UDINT := 0;
	BatchAcceptedResultAck			: UDINT := 0;
	// Each array has its own 16-entry job FIFO.  Jobs contain the final delay,
	// pressure and nozzle mask and therefore remain immutable during a pulse.
	BatchJobSequence				: ARRAY [0..15, 1..4] OF UDINT;
	BatchJobNozzleMask				: ARRAY [0..15, 1..4] OF BYTE;
	BatchJobPressureMbar			: ARRAY [0..15, 1..4] OF INT;
