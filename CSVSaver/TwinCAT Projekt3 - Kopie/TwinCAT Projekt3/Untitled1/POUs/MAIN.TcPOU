	GuiDelayMs4				: UINT := 0;
	GuiPulseDurationMs1		: UINT := 100;
	GuiPulseDurationMs2		: UINT := 100;
	GuiPulseDurationMs3		: UINT := 100;
	GuiPulseDurationMs4		: UINT := 100;
	GuiArrayEnabled1		: BOOL := TRUE;
	GuiArrayEnabled2		: BOOL := TRUE;
	GuiArrayEnabled3		: BOOL := FALSE;
	GuiArrayEnabled4		: BOOL := FALSE;
	GuiNozzleEnabled1		: BOOL := TRUE;
	GuiNozzleEnabled2		: BOOL := TRUE;
	GuiNozzleEnabled3		: BOOL := TRUE;
	GuiNozzleEnabled4		: BOOL := TRUE;
	GuiNozzleEnabled5		: BOOL := FALSE;
	GuiNozzleEnabled6		: BOOL := FALSE;
	GuiNozzleEnabled7		: BOOL := TRUE;
	GuiNozzleEnabled8		: BOOL := TRUE;
	GuiNozzleEnabled9		: BOOL := TRUE;
	GuiNozzleEnabled10		: BOOL := TRUE;
	GuiNozzleEnabled11		: BOOL := FALSE;
	GuiNozzleEnabled12		: BOOL := FALSE;
	GuiNozzleEnabled13		: BOOL := TRUE;
	GuiNozzleEnabled14		: BOOL := TRUE;
	GuiNozzleEnabled15		: BOOL := TRUE;
	GuiNozzleEnabled16		: BOOL := TRUE;
	GuiNozzleEnabled17		: BOOL := FALSE;
	GuiNozzleEnabled18		: BOOL := FALSE;
