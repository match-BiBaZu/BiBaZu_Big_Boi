	GuiReorientationQueuePressureMbar2	: INT := 0;
	GuiReorientationQueuePressureMbar3	: INT := 0;
	GuiReorientationQueuePressureMbar4	: INT := 0;
	GuiReorientationQueueDelayMs1	: UINT := 0;
	GuiReorientationQueueDelayMs2	: UINT := 0;
	GuiReorientationQueueDelayMs3	: UINT := 0;
	GuiReorientationQueueDelayMs4	: UINT := 0;
	GuiReorientationQueuePulseMs1	: UINT := 1;
	GuiReorientationQueuePulseMs2	: UINT := 1;
	GuiReorientationQueuePulseMs3	: UINT := 1;
	GuiReorientationQueuePulseMs4	: UINT := 1;
	GuiReorientationQueueOffsetMm1	: REAL := 0.0;
	GuiReorientationQueueOffsetMm2	: REAL := 0.0;
	GuiReorientationQueueOffsetMm3	: REAL := 0.0;
	GuiReorientationQueueOffsetMm4	: REAL := 0.0;
	GuiReorientationQueueForceResponseMs1	: REAL := 0.0;
	GuiReorientationQueueForceResponseMs2	: REAL := 0.0;
	GuiReorientationQueueForceResponseMs3	: REAL := 0.0;
	GuiReorientationQueueForceResponseMs4	: REAL := 0.0;
	GuiReorientationQueueForceSingleMs1	: REAL := 0.0;
	GuiReorientationQueueForceSingleMs2	: REAL := 0.0;
	GuiReorientationQueueForceSingleMs3	: REAL := 0.0;
	GuiReorientationQueueForceSingleMs4	: REAL := 0.0;
	ReorientationHeartbeatAck		: UDINT := 0;
	ReorientationHeartbeatAlive	: BOOL := FALSE;
	ReorientationState				: UINT := 0; //0 legacy,10 armed,20 running,30 drain,40 complete,90+ fault
	ReorientationFaultCode			: UINT := 0;
	ReorientationBusy				: BOOL := FALSE;
	ReorientationExitSeen			: BOOL := FALSE;
	ReorientationArraysIdle		: BOOL := TRUE;
	ReorientationExpectedArrayMask	: BYTE := 0;
	ReorientationTriggeredArrayMask	: BYTE := 0;
	ReorientationComplete			: BOOL := FALSE;
	ReorientationCycleCounter		: UDINT := 0;
	ReorientationLastHeartbeat		: UDINT := 0;
	ReorientationHeartbeatAgeMs	: UDINT := 0;
	ReorientationCycleAgeMs		: UDINT := 0;
	ReorientationDrainAgeMs		: UDINT := 0;
	ReorientationSafeLatch			: BOOL := FALSE;
	// Diagnostic context retained for non-fatal light-barrier warnings and for
	// compatibility with older GUIs that reported these conditions as fault 96.
	ReorientationFaultDetail		: UINT := 0; // 1=no clear, 2=queue mismatch, 3=sensor order
	ReorientationFaultSensor		: UINT := 0;
	ReorientationFaultExpectedSequence	: UDINT := 0;
	ReorientationFaultPreviousSequence	: UDINT := 0;
	ReorientationFaultQueueAck		: UDINT := 0;
	ReorientationFaultQueueSlotSequence	: UDINT := 0;
	ReorientationFaultBarrierStableMask	: BYTE := 0;
	// Non-fatal resynchronization after an intentionally airborne workpiece
	// skips barriers downstream of its final active nozzle array.
	// 1=downstream barriers skipped, 2=airborne duplicate, 3=no-clear edge,
	// 4=edge without matching queue slot, 5=out-of-order edge. All are non-fatal.
	ReorientationWarningCode		: UINT := 0;
	ReorientationWarningSensor		: UINT := 0;
	ReorientationWarningSequence	: UDINT := 0;
	ReorientationWarningPreviousSequence	: UDINT := 0;
	ReorientationWarningSkippedBarrierMask	: BYTE := 0;
	ReorientationWarningCounter		: UDINT := 0;
	// Public continuous-run queue/result diagnostics.
	ReorientationQueueDepth			: UINT := 0;
	ReorientationQueueCapacity		: UINT := 128;
	ReorientationQueueEnqueueAck		: UDINT := 0;
	ReorientationQueueEnteredCount	: UDINT := 0;
	ReorientationQueueCompletedCount	: UDINT := 0;
	ReorientationQueueBypassCount		: UDINT := 0;
	ReorientationSensorSequence1	: UDINT := 0;
	ReorientationSensorSequence2	: UDINT := 0;
	ReorientationSensorSequence3	: UDINT := 0;
	ReorientationSensorSequence4	: UDINT := 0;
	ReorientationSensorSequence5	: UDINT := 0;
	ReorientationSensorSequence6	: UDINT := 0;
	ReorientationSensorSequence7	: UDINT := 0;
	ReorientationSensorSequence8	: UDINT := 0;
	ReorientationResultAvailable	: BOOL := FALSE;
	ReorientationResultSequence		: UDINT := 0;
	ReorientationResultTriggeredMask	: BYTE := 0;
	ReorientationResultFaultCode	: UINT := 0;
	// Frozen 128-part ring.  A slot is not reusable until its result is ACKed.
	BatchQueueSequence				: ARRAY [0..127] OF UDINT;
	BatchQueueTrackId				: ARRAY [0..127] OF UDINT;
	BatchQueuePoseId				: ARRAY [0..127] OF UINT;
	BatchQueueDecisionCode			: ARRAY [0..127] OF UINT;
	BatchQueueArrayMask				: ARRAY [0..127] OF BYTE;
	BatchQueueNozzleMask			: ARRAY [0..127, 1..4] OF BYTE;
	BatchQueuePressureMbar			: ARRAY [0..127, 1..4] OF INT;
	BatchQueueDelayMs				: ARRAY [0..127, 1..4] OF UINT;
	BatchQueuePulseMs				: ARRAY [0..127, 1..4] OF UINT;
	BatchQueueOffsetMm				: ARRAY [0..127, 1..4] OF REAL;
	BatchQueueForceResponseMs		: ARRAY [0..127, 1..4] OF REAL;
	BatchQueueForceSingleMs			: ARRAY [0..127, 1..4] OF REAL;
	BatchQueuePairStartMs			: ARRAY [0..127, 1..4] OF UDINT;
	BatchQueueTriggeredMask			: ARRAY [0..127] OF BYTE;
	// Unlike TriggeredMask, this is set only while a real valve output is
	// commanded open. It marks this exact queued part as eligible for flight
	// recovery; it cannot prove pneumatic pressure or actual part motion.
	BatchQueueActuatedMask			: ARRAY [0..127] OF BYTE;
	BatchQueueFinishedMask			: ARRAY [0..127] OF BYTE;
	BatchQueueExitSeen				: ARRAY [0..127] OF BOOL;
	BatchResultSequence				: ARRAY [0..127] OF UDINT;
	BatchResultTriggeredMask		: ARRAY [0..127] OF BYTE;
	BatchResultFaultCode			: ARRAY [0..127] OF UINT;
	BatchNextSensorSequence			: ARRAY [1..8] OF UDINT;
	BatchSensorSequence				: ARRAY [1..8] OF UDINT;
	BatchSensorFalling				: ARRAY [1..8] OF BOOL;
	BatchSensorStable				: ARRAY [1..8] OF BOOL;
	BatchPairSpacingMm				: ARRAY [1..4] OF REAL;
	BatchSensorNeedsClear			: ARRAY [1..8] OF BOOL;
	PairedFirstBarrierFalling		: ARRAY [1..4] OF BOOL;
	PairedFirstBarrierLocked		: ARRAY [1..4] OF BOOL;
	PairedFirstBarrierLockStartMs	: ARRAY [1..4] OF UDINT;
	PairedSecondBarrierFalling		: ARRAY [1..4] OF BOOL;
	PairedSecondBarrierLocked		: ARRAY [1..4] OF BOOL;
	PairedSecondBarrierLockStartMs	: ARRAY [1..4] OF UDINT;
	PairedBarrierLockTimeoutMs		: UDINT := 500;
	BatchSensorOrderInvalid			: BOOL := FALSE;
	BatchCanResyncSkippedSensors	: BOOL := FALSE;
	BatchCurrentFlightConfirmed	: BOOL := FALSE;
	BatchIgnoreAirborneDuplicate	: BOOL := FALSE;
	BatchLastRequiredSensor			: INT := 0;
	BatchLastRequiredArrayMask		: BYTE := 0;
	BatchPreviousSlotIndex			: INT := 0;
