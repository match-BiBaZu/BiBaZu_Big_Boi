<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{e80dba2a-67f9-4c18-8302-7ea92125d6c4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	State					: INT  := 0; //state machine to control valves and motion terminal
	State2					: INT  := 2; //state machine for nozzle array 2
	State3					: INT  := 0; //state machine for nozzle array 3 and second VTEM unit
	State4					: INT  := 2; //state machine for nozzle array 4
	Counter					: INT  := 0; //timer counter that is in multiples of the PLC task time
	Counter2				: INT  := 0; //timer counter for the second nozzle array
	Counter3				: INT  := 0;
	Counter4				: INT  := 0;
	ShotDurationCycles		: INT  := 100; //100 cycles at 1 ms task time = 100 ms nozzle impulse
	ShotDurationCycles2		: INT  := 100; //pulse duration for the second nozzle array
	ShotDurationCycles3		: INT  := 100;
	ShotDurationCycles4		: INT  := 100;
	DelayDurationCycles		: INT  := 0; //delay cycles at 1 ms task time
	DelayDurationCycles2	: INT  := 0; //delay cycles for the second nozzle array
	DelayDurationCycles3	: INT  := 0;
	DelayDurationCycles4	: INT  := 0;
	OffsetDelayCycles1		: INT  := 0; //velocity-derived delay cycles for the first nozzle array
	OffsetDelayCycles2		: INT  := 0; //velocity-derived delay cycles for the second nozzle array
	OffsetDelayCycles3		: INT  := 0;
	OffsetDelayCycles4		: INT  := 0;
	LatchedDelayCycles1		: INT  := 0;
	LatchedDelayCycles2		: INT  := 0;
	LatchedDelayCycles3		: INT  := 0;
	LatchedDelayCycles4		: INT  := 0;
	LatchedNozzleEndCycles1	: INT  := 100;
	LatchedNozzleEndCycles2	: INT  := 100;
	LatchedNozzleEndCycles3	: INT  := 100;
	LatchedNozzleEndCycles4	: INT  := 100;
	
	TimeDelay				: BOOL := 0;
	DelayCounter			: INT  := 0;
	DelayCounter2			: INT  := 0;
	VelocityTimer			: TON;
	VelocityTimer2			: TON;
