	VelocityTiming2Active	: BOOL := FALSE;
	VelocityTiming3Active	: BOOL := FALSE;
	VelocityMeasurementValid: BOOL := FALSE;
	VelocityMeasurement2Valid: BOOL := FALSE;
	VelocityMeasurement3Valid: BOOL := FALSE;

	//GUI control values written through ADS
	GuiPressureMbar1		: INT  := 3000;
