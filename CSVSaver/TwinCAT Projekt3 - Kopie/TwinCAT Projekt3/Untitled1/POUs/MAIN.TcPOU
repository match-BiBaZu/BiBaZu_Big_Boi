	GuiLightBarrierDebounceEnabled6	: BOOL := FALSE;
	GuiLightBarrierDebounceEnabled7	: BOOL := FALSE;
	GuiLightBarrierDebounceEnabled8	: BOOL := FALSE;
	GuiBarrierCalibrationStart	: BOOL := FALSE;
	BarrierCalibrationActive	: BOOL := FALSE;
	BarrierCalibrationFirstCaptured	: BOOL := FALSE;
	BarrierCalibrationSecondCaptured	: BOOL := FALSE;
	BarrierCalibrationValid	: BOOL := FALSE;
	BarrierCalibrationFirstPosition	: UDINT := 0;
	BarrierCalibrationSecondPosition	: UDINT := 0;
	BarrierCalibrationDifferenceIncrements	: UDINT := 0;
	BarrierCalibrationDistanceMm	: REAL := 0.0;
	BarrierCalibrationPositionDelta	: LINT := 0;
	BarrierCalibrationFirstState	: BOOL := FALSE;
	BarrierCalibrationSecondState	: BOOL := FALSE;
	BarrierCalibrationFirstInitialState	: BOOL := FALSE;
