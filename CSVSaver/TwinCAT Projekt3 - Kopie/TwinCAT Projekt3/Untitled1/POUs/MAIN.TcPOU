	LightBarrierLastEventPosition2	: UDINT := 0;
	LightBarrierLastEventPosition3	: UDINT := 0;
	LightBarrierLastEventPosition4	: UDINT := 0;
	LightBarrierLastEventPosition5	: UDINT := 0;
	LightBarrierLastEventPosition6	: UDINT := 0;
	LightBarrierLastEventPosition7	: UDINT := 0;
	LightBarrierLastEventPosition8	: UDINT := 0;
	Array1TriggerPending		: BOOL := FALSE;
	Array2TriggerPending		: BOOL := FALSE;
	Array3TriggerPending		: BOOL := FALSE;
	Array4TriggerPending		: BOOL := FALSE;
	ForceDelayBusy			: BOOL := FALSE;
	ForceDelayStatusCode		: UINT := 0; //0 disabled, 1 armed, 2 measuring, 3 valid, 4 no peak
	ForceDelayResultCounter		: UDINT := 0;
	ForceDelayValidCount		: UDINT := 0;
	ForceDelayInvalidCount		: UDINT := 0;
	ForceDelayLastValid		: BOOL := FALSE;
	ForceDelayLightBarrierTimeMs	: UDINT := 0;
	ForceDelayPeakTimeMs		: UDINT := 0;
	ForceDelayPeakDelayMs		: UDINT := 0;
	ForceDelayElapsedMs		: UINT := 0;
	ForceDelayBaseline		: REAL := 0.0;
	ForceDelayPeak			: REAL := 0.0;
	ForceDelayPeakRise		: REAL := 0.0;
	ForceDelayCurrentSignal		: REAL := 0.0;
	ForceDelayBaselineBuffer1	: ARRAY [0..49] OF REAL;
	ForceDelayBaselineBuffer2	: ARRAY [0..49] OF REAL;
	ForceDelayBaselineSum1		: REAL := 0.0;
	ForceDelayBaselineSum2		: REAL := 0.0;
	ForceDelayBaselineIndex		: UINT := 0;
	ForceDelayBaselineCount		: UINT := 0;
	ForceDelayTrigger		: BOOL := FALSE;
	ActiveNozzleCount1		: INT := 0;
	ActiveNozzleCount2		: INT := 0;
	ActiveNozzleCount3		: INT := 0;
	ActiveNozzleCount4		: INT := 0;
	EffectiveForceResponseDelayMs1	: REAL := 0.0;
	EffectiveForceResponseDelayMs2	: REAL := 0.0;
	EffectiveForceResponseDelayMs3	: REAL := 0.0;
	EffectiveForceResponseDelayMs4	: REAL := 0.0;
	
	//EL 3068
	RawNozzlePressure AT %I*: INT  := 0; //The raw analogue input reading from the EL3068 terminal (max 32767)
	NozzlePressure			: REAL := 0.0; //converted to pressure value in bar
	
	RawNozzlePressure2 AT %I*: INT := 0; //raw reading from the second pressure sensor
	NozzlePressure2          : REAL := 0.0; //converted to pressure value in bar
	
	
	//Digital valve outputs
	//0 to close valve 1 to open valve
	OpenValve1 AT %Q*		: BOOL := 0;
	OpenValve2 AT %Q*		: BOOL := 0;
	OpenValve3 AT %Q*		: BOOL := 0;
	OpenValve4 AT %Q*		: BOOL := 0;
	OpenValve5 AT %Q*		: BOOL := 0;
	OpenValve6 AT %Q*		: BOOL := 0;
	OpenValve7 AT %Q*		: BOOL := 0;
	OpenValve8 AT %Q*		: BOOL := 0;
	OpenValve9 AT %Q*		: BOOL := 0;
	OpenValve10 AT %Q*		: BOOL := 0;
	OpenValve11 AT %Q*		: BOOL := 0;
	OpenValve12 AT %Q*		: BOOL := 0;
	OpenValve13 AT %Q*		: BOOL := 0;
	OpenValve14 AT %Q*		: BOOL := 0;
	OpenValve15 AT %Q*		: BOOL := 0;
	OpenValve16 AT %Q*		: BOOL := 0;
	OpenValve17 AT %Q*		: BOOL := 0;
	OpenValve18 AT %Q*		: BOOL := 0;
	OpenValve19 AT %Q*		: BOOL := 0;
	OpenValve20 AT %Q*		: BOOL := 0;
	OpenValve21 AT %Q*		: BOOL := 0;
	OpenValve22 AT %Q*		: BOOL := 0;
	OpenValve23 AT %Q*		: BOOL := 0;
	OpenValve24 AT %Q*		: BOOL := 0;

	//EL7047 stepper terminal, predefined PDO assignment "Positioning interface"
	StepperStmStatus AT %I*			: WORD := 0; //link to Term 14 STM Status/Status
	StepperPosBusy AT %I*			: BOOL := FALSE; //link to POS Status/Status/Busy
	StepperPosInTarget AT %I*		: BOOL := FALSE; //link to POS Status/Status/In-Target
	StepperPosWarning AT %I*		: BOOL := FALSE; //link to POS Status/Status/Warning
	StepperPosError AT %I*			: BOOL := FALSE; //link to POS Status/Status/Error
	StepperPosReadyToExecute AT %I*	: BOOL := FALSE; //link to POS Status/Status/Ready to execute
	StepperInternalPosition AT %I*	: UDINT := 0; //link to STM Internal position/Internal position
	StepperWcState AT %I*			: BOOL := FALSE; //optional: link to Term 14 WcState
	StepperInfoDataState AT %I*		: UINT := 0; //optional: link to Term 14 InfoData/State
	StepperControlEnable AT %Q*		: BOOL := FALSE; //link to STM Control/Control/Enable
	StepperControlReset AT %Q*		: BOOL := FALSE; //link to STM Control/Control/Reset
	StepperControlReduceTorque AT %Q*	: BOOL := FALSE; //link to STM Control/Control/Reduce torque
	StepperControlDigitalOutput1 AT %Q*	: BOOL := FALSE; //link to STM Control/Control/Digital output 1
	StepperPosExecute AT %Q*		: BOOL := FALSE; //link to POS Control/Control/Execute
	StepperPosEmergencyStop AT %Q*	: BOOL := FALSE; //link to POS Control/Control/Emergency stop
	StepperPosTargetPosition AT %Q*	: UDINT := 0; //link to POS Control/Target position
	StepperPosVelocity AT %Q*		: INT := 0; //link to POS Control/Velocity
	StepperPosStartType AT %Q*		: UINT := 0; //link to POS Control/Start type
	StepperPosAcceleration AT %Q*	: UINT := 1000; //link to POS Control/Acceleration
	StepperPosDeceleration AT %Q*	: UINT := 1000; //link to POS Control/Deceleration
	
	//VTEM Motion Terminal Variables
	FBValveControlV0		: FestoVTEMdc.FB_ValveControl; //Renaming function in program
	Valve0_IN AT %I*		: ARRAY [0..2] OF WORD;			//Input for VTEM Valves
	Valve0_OUT AT %Q*		: ARRAY [0..2] OF WORD;			//Output for VTEM Valves starts at QB0 and increases by 6 for every sequential insel
	Enable0					: BOOL := FALSE;				//Enables VTEM Valves
	Acknowledge0			: BOOL := FALSE;				//Acknowledges the Enabling variable. Must be done after enable is set to true
	ValveMode0				: BYTE := 3;					//Motion app used
	AppControl0				: BYTE := 3;					//0 = no valves, 1 = Valve02 only, 2 = valve04 only, 3 = both valves
	AppOption0				: BYTE;							//only used for motion apps 1 and 2
	PresValueV02			: INT  := 0;					//set pressure for V02 in thousandths of bar (1000 = 1 bar)
	PresValueV04			: INT  := 0;					//set pressure for V04
	ActValveMode0			: BYTE;							
	ActValveState0			: BYTE;
	ActAppState0			: INT;
	ActPresValueV02			: INT;							//Actual pressure output for V02
	ActPresValueV04			: INT;							//Actual pressure output for V04
	ResponseToValveModeSet0	: INT;							//Gives status of VTEM Terminal
	ErrorCode0				: INT;							//Must = 0, otherwise lookup errorcode

	FBValveControlV1		: FestoVTEMdc.FB_ValveControl; //Pressure control for VTEM unit 1
	Valve1_IN AT %I*		: ARRAY [0..2] OF WORD;			//Input for VTEM unit 1 valves
	Valve1_OUT AT %Q*		: ARRAY [0..2] OF WORD;			//Output for VTEM unit 1 valves, link to the next 6-byte insel
	Enable1					: BOOL := FALSE;				//Enables VTEM unit 1 valves
	Acknowledge1			: BOOL := FALSE;				//Acknowledges unit 1 enabling variable
	ValveMode1				: BYTE := 3;					//Motion app used
	AppControl1				: BYTE := 3;					//0 = no valves, 1 = Valve02 only, 2 = valve04 only, 3 = both valves
	AppOption1				: BYTE;							//only used for motion apps 1 and 2
	PresValueV12			: INT := 0;						//set pressure for unit 1 V02, used by nozzle array 3
	PresValueV14			: INT := 0;						//set pressure for unit 1 V04, used by nozzle array 4
	ActValveMode1			: BYTE;
	ActValveState1			: BYTE;
	ActAppState1			: INT;
	ActPresValueV12			: INT;							//Actual pressure output for unit 1 V02
	ActPresValueV14			: INT;							//Actual pressure output for unit 1 V04
	ResponseToValveModeSet1	: INT;							//Gives status of VTEM unit 1
	ErrorCode1				: INT;							//Must = 0, otherwise lookup errorcode
	
	//Pressure Variables
	PressureSum             : REAL  := 0.0;                 //sum of data points recorded by pressure sensor
	PressurePoints          : INT   := 0;                   //value for number of data points recorded by pressure sensor	
	PressureSum1            : REAL  := 0.0;                 //sum of pressure from nozzle 1
	PressureSum2            : REAL  := 0.0;                 //sum of pressure from nozzle 2
	PressurePoints1         : INT   := 0;
	PressurePoints2         : INT   := 0;
	
	AvgPressure             : REAL  := 0.0;                 //average pressure between the two nozzles
	AvgPressureN1           : REAL  := 0.0;                 //average pressure of the first nozzle
	AvgPressureN2           : REAL  := 0.0;                 //average pressure of the second nozzle 
	ShotCounter				: UDINT := 0;					//increments once for every completed nozzle shot
	LogPressureTrigger		: BOOL  := FALSE;				//one PLC-cycle pulse when a new shot value is ready
	
	N1PressureValues        : ARRAY [0..1000] OF REAL;        //array for the output of pressure values for nozzle 1
	N2PressureValues        : ARRAY [0..1000] OF REAL;        //array for the ouput of pressure values for nozzle 2

	NozzlePressures         : ARRAY [0..1000, 0..1] OF REAL;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[NozzlePressure := TO_REAL(RawNozzlePressure) * 10.0 / 32767.0;
NozzlePressure2 := TO_REAL(RawNozzlePressure2) * 10.0 / 32767.0;
LogPressureTrigger := FALSE;
LightBarrierEventClockMs := LightBarrierEventClockMs + 1;

// Explicit compatibility escape hatch for PressureControlGUI. It is accepted
// only after the batch owner is already fail-stopped; a live production run can
// never be stolen. The legacy GUI applies its normal SAFE_STOP_VALUES next.
IF GuiReorientationLegacyTakeover AND ReorientationSafeLatch THEN
	GuiConveyorEnabled := FALSE;
	GuiArrayEnabled1 := FALSE;
	GuiArrayEnabled2 := FALSE;
	GuiArrayEnabled3 := FALSE;
	GuiArrayEnabled4 := FALSE;
	GuiReorientationControlActive := FALSE;
	GuiReorientationAbort := FALSE;
	GuiReorientationStart := FALSE;
	GuiReorientationFinish := FALSE;
	ReorientationFaultCode := 0;
	ReorientationState := 0;
	ReorientationSafeLatch := FALSE;
	ReorientationHeartbeatAlive := FALSE;
	BatchJobCount[1] := 0; BatchJobCount[2] := 0; BatchJobCount[3] := 0; BatchJobCount[4] := 0;
	BatchActiveSequence[1] := 0; BatchActiveSequence[2] := 0;
	BatchActiveSequence[3] := 0; BatchActiveSequence[4] := 0;
	GuiReorientationLegacyTakeover := FALSE;
END_IF

// A communication loss must remain safe and must never fall back to legacy control.
IF GuiReorientationControlActive THEN
	IF GuiReorientationHeartbeat <> ReorientationLastHeartbeat THEN
		ReorientationLastHeartbeat := GuiReorientationHeartbeat;
		ReorientationHeartbeatAck := GuiReorientationHeartbeat;
		ReorientationHeartbeatAgeMs := 0;
		ReorientationHeartbeatAlive := TRUE;
	ELSIF ReorientationHeartbeatAgeMs < 16#FFFFFFFF THEN
		ReorientationHeartbeatAgeMs := ReorientationHeartbeatAgeMs + 1;
	END_IF
	IF ReorientationHeartbeatAgeMs > 2000 THEN
		ReorientationHeartbeatAlive := FALSE;
		ReorientationFaultCode := 91;
		ReorientationState := 91;
		ReorientationSafeLatch := TRUE;
	END_IF
ELSIF NOT ReorientationSafeLatch THEN
	ReorientationHeartbeatAlive := FALSE;
	ReorientationState := 0;
END_IF

IF GuiReorientationReset AND GuiReorientationControlActive THEN
	ReorientationFaultCode := 0;
	ReorientationSafeLatch := FALSE;
	ReorientationState := 10;
	ReorientationHeartbeatAgeMs := 0;
	ReorientationLastHeartbeat := GuiReorientationHeartbeat;
	ReorientationHeartbeatAck := GuiReorientationHeartbeat;
	ReorientationHeartbeatAlive := TRUE;
	ReorientationComplete := FALSE;
	ReorientationExitSeen := FALSE;
	ReorientationTriggeredArrayMask := 0;
	ReorientationQueueEnqueueAck := 0;
	ReorientationQueueEnteredCount := 0;
	ReorientationQueueCompletedCount := 0;
	ReorientationQueueBypassCount := 0;
	ReorientationSensorSequence1 := 0;
	ReorientationSensorSequence2 := 0;
	ReorientationSensorSequence3 := 0;
	ReorientationSensorSequence4 := 0;
	ReorientationSensorSequence5 := 0;
	ReorientationSensorSequence6 := 0;
	ReorientationSensorSequence7 := 0;
	ReorientationSensorSequence8 := 0;
	ReorientationResultAvailable := FALSE;
	ReorientationResultSequence := 0;
	ReorientationResultTriggeredMask := 0;
	ReorientationResultFaultCode := 0;
	ReorientationFaultDetail := 0;
	ReorientationFaultSensor := 0;
	ReorientationFaultExpectedSequence := 0;
	ReorientationFaultPreviousSequence := 0;
	ReorientationFaultQueueAck := 0;
	ReorientationFaultQueueSlotSequence := 0;
	ReorientationFaultBarrierStableMask := 0;
	ReorientationWarningCode := 0;
	ReorientationWarningSensor := 0;
	ReorientationWarningSequence := 0;
	ReorientationWarningPreviousSequence := 0;
	ReorientationWarningSkippedBarrierMask := 0;
	ReorientationWarningCounter := 0;
	BatchNextCompleteSequence := 1;
	BatchLastAcceptedCommit := 0;
	BatchAcceptedResultAck := 0;
	GuiReorientationQueueCommit := 0;
	GuiReorientationQueueSequence := 0;
	GuiReorientationResultAck := 0;
	FOR BatchLoopIndex := 1 TO 8 DO
		BatchNextSensorSequence[BatchLoopIndex] := 1;
		BatchSensorSequence[BatchLoopIndex] := 0;
		BatchSensorNeedsClear[BatchLoopIndex] := FALSE;
	END_FOR
	FOR BatchLoopIndex := 1 TO 4 DO
		BatchJobHead[BatchLoopIndex] := 0;
		BatchJobTail[BatchLoopIndex] := 0;
		BatchJobCount[BatchLoopIndex] := 0;
		BatchActiveSequence[BatchLoopIndex] := 0;
		PairedFirstBarrierLocked[BatchLoopIndex] := FALSE;
		PairedFirstBarrierLockStartMs[BatchLoopIndex] := 0;
		PairedSecondBarrierLocked[BatchLoopIndex] := FALSE;
		PairedSecondBarrierLockStartMs[BatchLoopIndex] := 0;
	END_FOR
	// Reset is a command pulse. The PLC consumes it once so the GUI does not
	// need a separate reset/ready handshake just to lower the bit again.
	GuiReorientationReset := FALSE;
END_IF

IF GuiReorientationAbort AND GuiReorientationControlActive THEN
	ReorientationFaultCode := 90;
	ReorientationState := 90;
	ReorientationSafeLatch := TRUE;
END_IF

IF GuiReorientationControlActive AND (ReorientationState >= 20) AND (ReorientationState <= 30)
	AND (StepperPosError OR (ErrorCode0 <> 0) OR (ErrorCode1 <> 0)) THEN
	ReorientationFaultCode := 94;
	ReorientationState := 94;
	ReorientationSafeLatch := TRUE;
END_IF

IF ReorientationSafeLatch THEN
	GuiConveyorEnabled := FALSE;
	GuiArrayEnabled1 := FALSE;
	GuiArrayEnabled2 := FALSE;
	GuiArrayEnabled3 := FALSE;
	GuiArrayEnabled4 := FALSE;
	Array1TriggerPending := FALSE;
	Array2TriggerPending := FALSE;
	Array3TriggerPending := FALSE;
	Array4TriggerPending := FALSE;
END_IF

IF GuiResetVelocityEstimates THEN
	LastVelocityTimeMs := 0;
	LastVelocityTime2Ms := 0;
	LastVelocityTime3Ms := 0;
	LastVelocityTime4Ms := 0;
	VelocityTimingActive := FALSE;
	VelocityTiming2Active := FALSE;
	VelocityTiming3Active := FALSE;
	VelocityTiming4Active := FALSE;
	VelocityMeasurementValid := FALSE;
	VelocityMeasurement2Valid := FALSE;
	VelocityMeasurement3Valid := FALSE;
	VelocityMeasurement4Valid := FALSE;
	EstimatedVelocityMmPerSec := 0.0;
	EstimatedVelocityMmPerSec1 := 0.0;
	EstimatedVelocityMmPerSec2 := 0.0;
	EstimatedVelocityMmPerSec3 := 0.0;
	EstimatedVelocityMmPerSec4 := 0.0;
	EstimatedOffsetDelayMs1 := 0.0;
	EstimatedOffsetDelayMs2 := 0.0;
	EstimatedOffsetDelayMs3 := 0.0;
	EstimatedOffsetDelayMs4 := 0.0;
	OffsetDelayCycles1 := 0;
	OffsetDelayCycles2 := 0;
	OffsetDelayCycles3 := 0;
	OffsetDelayCycles4 := 0;
	GuiResetVelocityEstimates := FALSE;
END_IF

VelocityTimer(IN := VelocityTimingActive, PT := T#30S);
VelocityTimer2(IN := VelocityTiming2Active, PT := T#30S);
VelocityTimer3(IN := VelocityTiming3Active, PT := T#30S);
VelocityTimer4(IN := VelocityTiming4Active, PT := T#30S);

// Feed each idle array from its private FIFO.  The copied GUI-compatible fields
// are not touched again until this pulse has completed, so the existing VTEM
// state machines operate on an immutable per-part snapshot.
IF GuiReorientationControlActive AND ((ReorientationState = 20) OR (ReorientationState = 30)) THEN
	IF (State = 2) AND (BatchActiveSequence[1] = 0) AND (BatchJobCount[1] > 0) THEN
		BatchActiveSequence[1] := BatchJobSequence[BatchJobHead[1], 1];
		GuiPressureMbar1 := BatchJobPressureMbar[BatchJobHead[1], 1];
		GuiDelayMs1 := INT_TO_UINT(BatchJobDelayCycles[BatchJobHead[1], 1]);
		GuiPulseDurationMs1 := INT_TO_UINT(BatchJobPulseCycles[BatchJobHead[1], 1]);
		GuiOffsetMm1 := 0.0;
		GuiForceResponseDelayMs1 := 0.0;
		GuiForceSingleNozzleResponseDelayMs1 := 0.0;
		GuiArrayEnabled1 := TRUE;
		GuiNozzleEnabled1 := (BatchJobNozzleMask[BatchJobHead[1], 1] AND BYTE#1) <> BYTE#0;
		GuiNozzleEnabled2 := (BatchJobNozzleMask[BatchJobHead[1], 1] AND BYTE#2) <> BYTE#0;
		GuiNozzleEnabled3 := (BatchJobNozzleMask[BatchJobHead[1], 1] AND BYTE#4) <> BYTE#0;
		GuiNozzleEnabled4 := (BatchJobNozzleMask[BatchJobHead[1], 1] AND BYTE#8) <> BYTE#0;
		GuiNozzleEnabled5 := (BatchJobNozzleMask[BatchJobHead[1], 1] AND BYTE#16) <> BYTE#0;
		GuiNozzleEnabled6 := (BatchJobNozzleMask[BatchJobHead[1], 1] AND BYTE#32) <> BYTE#0;
		BatchJobHead[1] := (BatchJobHead[1] + 1) MOD 16;
		BatchJobCount[1] := BatchJobCount[1] - 1;
		Array1TriggerPending := TRUE;
	END_IF
	IF (State2 = 2) AND (BatchActiveSequence[2] = 0) AND (BatchJobCount[2] > 0) THEN
		BatchActiveSequence[2] := BatchJobSequence[BatchJobHead[2], 2];
		GuiPressureMbar2 := BatchJobPressureMbar[BatchJobHead[2], 2];
		GuiDelayMs2 := INT_TO_UINT(BatchJobDelayCycles[BatchJobHead[2], 2]);
		GuiPulseDurationMs2 := INT_TO_UINT(BatchJobPulseCycles[BatchJobHead[2], 2]);
		GuiOffsetMm2 := 0.0;
		GuiForceResponseDelayMs2 := 0.0;
		GuiForceSingleNozzleResponseDelayMs2 := 0.0;
		GuiArrayEnabled2 := TRUE;
		GuiNozzleEnabled7 := (BatchJobNozzleMask[BatchJobHead[2], 2] AND BYTE#1) <> BYTE#0;
		GuiNozzleEnabled8 := (BatchJobNozzleMask[BatchJobHead[2], 2] AND BYTE#2) <> BYTE#0;
		GuiNozzleEnabled9 := (BatchJobNozzleMask[BatchJobHead[2], 2] AND BYTE#4) <> BYTE#0;
		GuiNozzleEnabled10 := (BatchJobNozzleMask[BatchJobHead[2], 2] AND BYTE#8) <> BYTE#0;
		GuiNozzleEnabled11 := (BatchJobNozzleMask[BatchJobHead[2], 2] AND BYTE#16) <> BYTE#0;
		GuiNozzleEnabled12 := (BatchJobNozzleMask[BatchJobHead[2], 2] AND BYTE#32) <> BYTE#0;
		BatchJobHead[2] := (BatchJobHead[2] + 1) MOD 16;
		BatchJobCount[2] := BatchJobCount[2] - 1;
		Array2TriggerPending := TRUE;
	END_IF
	IF (State3 = 2) AND (BatchActiveSequence[3] = 0) AND (BatchJobCount[3] > 0) THEN
		BatchActiveSequence[3] := BatchJobSequence[BatchJobHead[3], 3];
		GuiPressureMbar3 := BatchJobPressureMbar[BatchJobHead[3], 3];
		GuiDelayMs3 := INT_TO_UINT(BatchJobDelayCycles[BatchJobHead[3], 3]);
		GuiPulseDurationMs3 := INT_TO_UINT(BatchJobPulseCycles[BatchJobHead[3], 3]);
		GuiOffsetMm3 := 0.0;
		GuiForceResponseDelayMs3 := 0.0;
		GuiForceSingleNozzleResponseDelayMs3 := 0.0;
		GuiArrayEnabled3 := TRUE;
		GuiNozzleEnabled13 := (BatchJobNozzleMask[BatchJobHead[3], 3] AND BYTE#1) <> BYTE#0;
		GuiNozzleEnabled14 := (BatchJobNozzleMask[BatchJobHead[3], 3] AND BYTE#2) <> BYTE#0;
		GuiNozzleEnabled15 := (BatchJobNozzleMask[BatchJobHead[3], 3] AND BYTE#4) <> BYTE#0;
		GuiNozzleEnabled16 := (BatchJobNozzleMask[BatchJobHead[3], 3] AND BYTE#8) <> BYTE#0;
		GuiNozzleEnabled17 := (BatchJobNozzleMask[BatchJobHead[3], 3] AND BYTE#16) <> BYTE#0;
		GuiNozzleEnabled18 := (BatchJobNozzleMask[BatchJobHead[3], 3] AND BYTE#32) <> BYTE#0;
		BatchJobHead[3] := (BatchJobHead[3] + 1) MOD 16;
		BatchJobCount[3] := BatchJobCount[3] - 1;
		Array3TriggerPending := TRUE;
	END_IF
	IF (State4 = 2) AND (BatchActiveSequence[4] = 0) AND (BatchJobCount[4] > 0) THEN
		BatchActiveSequence[4] := BatchJobSequence[BatchJobHead[4], 4];
		GuiPressureMbar4 := BatchJobPressureMbar[BatchJobHead[4], 4];
		GuiDelayMs4 := INT_TO_UINT(BatchJobDelayCycles[BatchJobHead[4], 4]);
		GuiPulseDurationMs4 := INT_TO_UINT(BatchJobPulseCycles[BatchJobHead[4], 4]);
		GuiOffsetMm4 := 0.0;
		GuiForceResponseDelayMs4 := 0.0;
		GuiForceSingleNozzleResponseDelayMs4 := 0.0;
		GuiArrayEnabled4 := TRUE;
		GuiNozzleEnabled19 := (BatchJobNozzleMask[BatchJobHead[4], 4] AND BYTE#1) <> BYTE#0;
		GuiNozzleEnabled20 := (BatchJobNozzleMask[BatchJobHead[4], 4] AND BYTE#2) <> BYTE#0;
		GuiNozzleEnabled21 := (BatchJobNozzleMask[BatchJobHead[4], 4] AND BYTE#4) <> BYTE#0;
		GuiNozzleEnabled22 := (BatchJobNozzleMask[BatchJobHead[4], 4] AND BYTE#8) <> BYTE#0;
		GuiNozzleEnabled23 := (BatchJobNozzleMask[BatchJobHead[4], 4] AND BYTE#16) <> BYTE#0;
		GuiNozzleEnabled24 := (BatchJobNozzleMask[BatchJobHead[4], 4] AND BYTE#32) <> BYTE#0;
		BatchJobHead[4] := (BatchJobHead[4] + 1) MOD 16;
		BatchJobCount[4] := BatchJobCount[4] - 1;
		Array4TriggerPending := TRUE;
	END_IF
END_IF

Array1Active := NOT GuiConveyorCalibrationMode AND NOT GuiVelocityCheckMode AND GuiArrayEnabled1 AND (GuiNozzleEnabled1 OR GuiNozzleEnabled2 OR GuiNozzleEnabled3 OR GuiNozzleEnabled4 OR GuiNozzleEnabled5 OR GuiNozzleEnabled6);
Array2Active := NOT GuiConveyorCalibrationMode AND NOT GuiVelocityCheckMode AND GuiArrayEnabled2 AND (GuiNozzleEnabled7 OR GuiNozzleEnabled8 OR GuiNozzleEnabled9 OR GuiNozzleEnabled10 OR GuiNozzleEnabled11 OR GuiNozzleEnabled12);
Array3Active := NOT GuiConveyorCalibrationMode AND NOT GuiVelocityCheckMode AND GuiArrayEnabled3 AND (GuiNozzleEnabled13 OR GuiNozzleEnabled14 OR GuiNozzleEnabled15 OR GuiNozzleEnabled16 OR GuiNozzleEnabled17 OR GuiNozzleEnabled18);
Array4Active := NOT GuiConveyorCalibrationMode AND NOT GuiVelocityCheckMode AND GuiArrayEnabled4 AND (GuiNozzleEnabled19 OR GuiNozzleEnabled20 OR GuiNozzleEnabled21 OR GuiNozzleEnabled22 OR GuiNozzleEnabled23 OR GuiNozzleEnabled24);

IF GuiConveyorSpeedMmPerSec < 0.0 THEN
	GuiConveyorSpeedMmPerSec := 0.0;
ELSIF GuiConveyorSpeedMmPerSec > 5000.0 THEN
	GuiConveyorSpeedMmPerSec := 5000.0;
END_IF

IF GuiConveyorMaxSpeedMmPerSec < 1.0 THEN
	GuiConveyorMaxSpeedMmPerSec := 1.0;
ELSIF GuiConveyorMaxSpeedMmPerSec > 5000.0 THEN
	GuiConveyorMaxSpeedMmPerSec := 5000.0;
END_IF

ConveyorSpeedMmPerSec := GuiConveyorSpeedMmPerSec;
IF ConveyorSpeedMmPerSec > GuiConveyorMaxSpeedMmPerSec THEN
	ConveyorSpeedMmPerSec := GuiConveyorMaxSpeedMmPerSec;
END_IF

IF GuiCalibrationMarkerDistanceMm < 1.0 THEN
	GuiCalibrationMarkerDistanceMm := 1.0;
ELSIF GuiCalibrationMarkerDistanceMm > 5000.0 THEN
	GuiCalibrationMarkerDistanceMm := 5000.0;
END_IF

IF GuiCalibrationJogSteps < 1 THEN
	GuiCalibrationJogSteps := 1;
ELSIF GuiCalibrationJogSteps > 100000 THEN
	GuiCalibrationJogSteps := 100000;
END_IF

IF GuiCalibrationJogSpeedFullStepsPerSec < 1.0 THEN
	GuiCalibrationJogSpeedFullStepsPerSec := 1.0;
ELSIF GuiCalibrationJogSpeedFullStepsPerSec > 500.0 THEN
	GuiCalibrationJogSpeedFullStepsPerSec := 500.0;
END_IF

// Entering calibration is fail-safe: normal belt motion remains disabled until explicitly re-enabled.
IF GuiConveyorCalibrationMode AND NOT LastConveyorCalibrationMode THEN
	GuiConveyorEnabled := FALSE;
	CalibrationLeftMarkValid := FALSE;
	CalibrationRightMarkValid := FALSE;
	CalibrationPositionDifferenceIncrements := 0;
	CalibrationFullStepDifference := 0.0;
	CalibrationStatusCode := 0;
END_IF
LastConveyorCalibrationMode := GuiConveyorCalibrationMode;

IF GuiBarrierCalibrationDebounceMs < 1 THEN
	GuiBarrierCalibrationDebounceMs := 1;
ELSIF GuiBarrierCalibrationDebounceMs > 200 THEN
	GuiBarrierCalibrationDebounceMs := 200;
END_IF

// All production timing and valve triggers use these shared, stable sensor states.
// Normalize the electrical polarity first. TRUE means clear beam and FALSE means part present.
LightBarrierLogical1 := LightBarrierOn1 <> GuiLightBarrierInvert1;
LightBarrierLogical2 := LightBarrierOn2 <> GuiLightBarrierInvert2;
LightBarrierLogical3 := LightBarrierOn3 <> GuiLightBarrierInvert3;
LightBarrierLogical4 := LightBarrierOn4 <> GuiLightBarrierInvert4;
LightBarrierLogical5 := LightBarrierOn5 <> GuiLightBarrierInvert5;
LightBarrierLogical6 := LightBarrierOn6 <> GuiLightBarrierInvert6;
LightBarrierLogical7 := LightBarrierOn7 <> GuiLightBarrierInvert7;
LightBarrierLogical8 := LightBarrierOn8 <> GuiLightBarrierInvert8;

// Changing polarity re-synchronizes the debouncer without generating an artificial edge.
IF (GuiLightBarrierInvert1 <> LastLightBarrierInvert1)
	OR (GuiLightBarrierInvert2 <> LastLightBarrierInvert2)
	OR (GuiLightBarrierInvert3 <> LastLightBarrierInvert3)
	OR (GuiLightBarrierInvert4 <> LastLightBarrierInvert4)
	OR (GuiLightBarrierInvert5 <> LastLightBarrierInvert5)
	OR (GuiLightBarrierInvert6 <> LastLightBarrierInvert6)
	OR (GuiLightBarrierInvert7 <> LastLightBarrierInvert7)
	OR (GuiLightBarrierInvert8 <> LastLightBarrierInvert8)
	OR (GuiLightBarrierDebounceEnabled1 <> LastLightBarrierDebounceEnabled1)
	OR (GuiLightBarrierDebounceEnabled2 <> LastLightBarrierDebounceEnabled2)
	OR (GuiLightBarrierDebounceEnabled3 <> LastLightBarrierDebounceEnabled3)
	OR (GuiLightBarrierDebounceEnabled4 <> LastLightBarrierDebounceEnabled4)
	OR (GuiLightBarrierDebounceEnabled5 <> LastLightBarrierDebounceEnabled5)
	OR (GuiLightBarrierDebounceEnabled6 <> LastLightBarrierDebounceEnabled6)
	OR (GuiLightBarrierDebounceEnabled7 <> LastLightBarrierDebounceEnabled7)
	OR (GuiLightBarrierDebounceEnabled8 <> LastLightBarrierDebounceEnabled8) THEN
	LightBarrierDebounceInitialized := FALSE;
	LightBarrierStableCounter1 := 0;
	LightBarrierStableCounter2 := 0;
	LightBarrierStableCounter3 := 0;
	LightBarrierStableCounter4 := 0;
	LightBarrierStableCounter5 := 0;
	LightBarrierStableCounter6 := 0;
	LightBarrierStableCounter7 := 0;
	LightBarrierStableCounter8 := 0;
END_IF
LastLightBarrierInvert1 := GuiLightBarrierInvert1;
LastLightBarrierInvert2 := GuiLightBarrierInvert2;
LastLightBarrierInvert3 := GuiLightBarrierInvert3;
LastLightBarrierInvert4 := GuiLightBarrierInvert4;
LastLightBarrierInvert5 := GuiLightBarrierInvert5;
LastLightBarrierInvert6 := GuiLightBarrierInvert6;
LastLightBarrierInvert7 := GuiLightBarrierInvert7;
LastLightBarrierInvert8 := GuiLightBarrierInvert8;
LastLightBarrierDebounceEnabled1 := GuiLightBarrierDebounceEnabled1;
LastLightBarrierDebounceEnabled2 := GuiLightBarrierDebounceEnabled2;
LastLightBarrierDebounceEnabled3 := GuiLightBarrierDebounceEnabled3;
LastLightBarrierDebounceEnabled4 := GuiLightBarrierDebounceEnabled4;
LastLightBarrierDebounceEnabled5 := GuiLightBarrierDebounceEnabled5;
LastLightBarrierDebounceEnabled6 := GuiLightBarrierDebounceEnabled6;
LastLightBarrierDebounceEnabled7 := GuiLightBarrierDebounceEnabled7;
LastLightBarrierDebounceEnabled8 := GuiLightBarrierDebounceEnabled8;

// On startup, synchronize without creating a false edge.
IF NOT LightBarrierDebounceInitialized THEN
	LightBarrierStable1 := LightBarrierLogical1;
	LightBarrierStable2 := LightBarrierLogical2;
	LightBarrierStable3 := LightBarrierLogical3;
	LightBarrierStable4 := LightBarrierLogical4;
	LightBarrierStable5 := LightBarrierLogical5;
	LightBarrierStable6 := LightBarrierLogical6;
	LightBarrierStable7 := LightBarrierLogical7;
	LightBarrierStable8 := LightBarrierLogical8;
	LastLightBarrier1 := LightBarrierLogical1;
	LastLightBarrier2 := LightBarrierLogical2;
	LastLightBarrier3 := LightBarrierLogical3;
	LastLightBarrier4 := LightBarrierLogical4;
	LastLightBarrier5 := LightBarrierLogical5;
	LastLightBarrier6 := LightBarrierLogical6;
	LastLightBarrier7 := LightBarrierLogical7;
	LastLightBarrier8 := LightBarrierLogical8;
	LightBarrierStableCounter1 := 0;
	LightBarrierStableCounter2 := 0;
	LightBarrierStableCounter3 := 0;
	LightBarrierStableCounter4 := 0;
	LightBarrierStableCounter5 := 0;
	LightBarrierStableCounter6 := 0;
	LightBarrierStableCounter7 := 0;
	LightBarrierStableCounter8 := 0;
	LightBarrierDebounceInitialized := TRUE;
ELSE
	IF NOT GuiLightBarrierDebounceEnabled1 THEN
		LightBarrierStable1 := LightBarrierLogical1;
		LightBarrierStableCounter1 := 0;
	ELSIF LightBarrierLogical1 <> LightBarrierStable1 THEN
		IF LightBarrierStableCounter1 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter1 := LightBarrierStableCounter1 + 1;
		END_IF
		IF LightBarrierStableCounter1 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable1 := LightBarrierLogical1;
			LightBarrierStableCounter1 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter1 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled2 THEN
		LightBarrierStable2 := LightBarrierLogical2;
		LightBarrierStableCounter2 := 0;
	ELSIF LightBarrierLogical2 <> LightBarrierStable2 THEN
		IF LightBarrierStableCounter2 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter2 := LightBarrierStableCounter2 + 1;
		END_IF
		IF LightBarrierStableCounter2 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable2 := LightBarrierLogical2;
			LightBarrierStableCounter2 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter2 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled3 THEN
		LightBarrierStable3 := LightBarrierLogical3;
		LightBarrierStableCounter3 := 0;
	ELSIF LightBarrierLogical3 <> LightBarrierStable3 THEN
		IF LightBarrierStableCounter3 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter3 := LightBarrierStableCounter3 + 1;
		END_IF
		IF LightBarrierStableCounter3 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable3 := LightBarrierLogical3;
			LightBarrierStableCounter3 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter3 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled4 THEN
		LightBarrierStable4 := LightBarrierLogical4;
		LightBarrierStableCounter4 := 0;
	ELSIF LightBarrierLogical4 <> LightBarrierStable4 THEN
		IF LightBarrierStableCounter4 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter4 := LightBarrierStableCounter4 + 1;
		END_IF
		IF LightBarrierStableCounter4 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable4 := LightBarrierLogical4;
			LightBarrierStableCounter4 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter4 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled5 THEN
		LightBarrierStable5 := LightBarrierLogical5;
		LightBarrierStableCounter5 := 0;
	ELSIF LightBarrierLogical5 <> LightBarrierStable5 THEN
		IF LightBarrierStableCounter5 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter5 := LightBarrierStableCounter5 + 1;
		END_IF
		IF LightBarrierStableCounter5 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable5 := LightBarrierLogical5;
			LightBarrierStableCounter5 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter5 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled6 THEN
		LightBarrierStable6 := LightBarrierLogical6;
		LightBarrierStableCounter6 := 0;
	ELSIF LightBarrierLogical6 <> LightBarrierStable6 THEN
		IF LightBarrierStableCounter6 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter6 := LightBarrierStableCounter6 + 1;
		END_IF
		IF LightBarrierStableCounter6 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable6 := LightBarrierLogical6;
			LightBarrierStableCounter6 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter6 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled7 THEN
		LightBarrierStable7 := LightBarrierLogical7;
		LightBarrierStableCounter7 := 0;
	ELSIF LightBarrierLogical7 <> LightBarrierStable7 THEN
		IF LightBarrierStableCounter7 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter7 := LightBarrierStableCounter7 + 1;
		END_IF
		IF LightBarrierStableCounter7 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable7 := LightBarrierLogical7;
			LightBarrierStableCounter7 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter7 := 0;
	END_IF
	IF NOT GuiLightBarrierDebounceEnabled8 THEN
		LightBarrierStable8 := LightBarrierLogical8;
		LightBarrierStableCounter8 := 0;
	ELSIF LightBarrierLogical8 <> LightBarrierStable8 THEN
		IF LightBarrierStableCounter8 < GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStableCounter8 := LightBarrierStableCounter8 + 1;
		END_IF
		IF LightBarrierStableCounter8 >= GuiBarrierCalibrationDebounceMs THEN
			LightBarrierStable8 := LightBarrierLogical8;
			LightBarrierStableCounter8 := 0;
		END_IF
	ELSE
		LightBarrierStableCounter8 := 0;
	END_IF
END_IF

CASE GuiBarrierCalibrationFirstSensor OF
	1: BarrierCalibrationFirstState := LightBarrierLogical1;
	2: BarrierCalibrationFirstState := LightBarrierLogical2;
	3: BarrierCalibrationFirstState := LightBarrierLogical3;
	4: BarrierCalibrationFirstState := LightBarrierLogical4;
	5: BarrierCalibrationFirstState := LightBarrierLogical5;
	6: BarrierCalibrationFirstState := LightBarrierLogical6;
	7: BarrierCalibrationFirstState := LightBarrierLogical7;
	8: BarrierCalibrationFirstState := LightBarrierLogical8;
ELSE
	BarrierCalibrationFirstState := FALSE;
END_CASE

CASE GuiBarrierCalibrationSecondSensor OF
	1: BarrierCalibrationSecondState := LightBarrierLogical1;
	2: BarrierCalibrationSecondState := LightBarrierLogical2;
	3: BarrierCalibrationSecondState := LightBarrierLogical3;
	4: BarrierCalibrationSecondState := LightBarrierLogical4;
	5: BarrierCalibrationSecondState := LightBarrierLogical5;
	6: BarrierCalibrationSecondState := LightBarrierLogical6;
	7: BarrierCalibrationSecondState := LightBarrierLogical7;
	8: BarrierCalibrationSecondState := LightBarrierLogical8;
ELSE
	BarrierCalibrationSecondState := FALSE;
END_CASE

// Prepare a light-barrier spacing measurement before the GUI starts a long relative move.
IF GuiBarrierCalibrationStart THEN
	IF GuiConveyorCalibrationMode
		AND GuiConveyorCalibrationValid
		AND (GuiConveyorMmPerFullStep > 0.0)
		AND (ConveyorMotionState = 0)
		AND NOT StepperPosBusy
		AND StepperPosReadyToExecute
		AND (GuiBarrierCalibrationFirstSensor >= 1)
		AND (GuiBarrierCalibrationFirstSensor <= 8)
		AND (GuiBarrierCalibrationSecondSensor >= 1)
		AND (GuiBarrierCalibrationSecondSensor <= 8)
		AND (GuiBarrierCalibrationFirstSensor <> GuiBarrierCalibrationSecondSensor) THEN
		BarrierCalibrationActive := TRUE;
		BarrierCalibrationFirstCaptured := FALSE;
		BarrierCalibrationSecondCaptured := FALSE;
		BarrierCalibrationValid := FALSE;
		BarrierCalibrationFirstPosition := 0;
		BarrierCalibrationSecondPosition := 0;
		BarrierCalibrationDifferenceIncrements := 0;
		BarrierCalibrationDistanceMm := 0.0;
		BarrierCalibrationFirstInitialState := BarrierCalibrationFirstState;
		BarrierCalibrationSecondInitialState := BarrierCalibrationSecondState;
		BarrierCalibrationFirstCandidatePosition := 0;
		BarrierCalibrationSecondCandidatePosition := 0;
		BarrierCalibrationFirstStableCycles := 0;
		BarrierCalibrationSecondStableCycles := 0;
		BarrierCalibrationStatusCode := 1;
	ELSE
		BarrierCalibrationActive := FALSE;
		BarrierCalibrationStatusCode := 4;
		GuiCalibrationMoveRight := FALSE;
	END_IF
	GuiBarrierCalibrationStart := FALSE;
END_IF

IF GuiConveyorCalibrationValid AND (GuiConveyorMmPerFullStep > 0.0) THEN
	CalibrationStepsPerMm := 1.0 / GuiConveyorMmPerFullStep;
ELSE
	GuiConveyorCalibrationValid := FALSE;
	CalibrationStepsPerMm := 0.0;
END_IF

// Capture either marker only while the terminal is stationary.
IF GuiCalibrationCaptureLeftMark THEN
	IF GuiConveyorCalibrationMode AND (ConveyorMotionState = 0) AND NOT StepperPosBusy THEN
		CalibrationLeftPosition := StepperInternalPosition;
		CalibrationLeftMarkValid := TRUE;
		CalibrationStatusCode := 0;
	ELSE
		CalibrationStatusCode := 4;
	END_IF
	GuiCalibrationCaptureLeftMark := FALSE;
END_IF

IF GuiCalibrationCaptureRightMark THEN
	IF GuiConveyorCalibrationMode AND (ConveyorMotionState = 0) AND NOT StepperPosBusy THEN
		CalibrationRightPosition := StepperInternalPosition;
		CalibrationRightMarkValid := TRUE;
		CalibrationStatusCode := 0;
	ELSE
		CalibrationStatusCode := 4;
	END_IF
	GuiCalibrationCaptureRightMark := FALSE;
END_IF

// Recalculate whenever both positions or the physical marker spacing change.
IF CalibrationLeftMarkValid AND CalibrationRightMarkValid THEN
	// Interpret the internal counter as signed so a short negative move across zero does not look like 2^32 increments.
	CalibrationPositionDelta := DINT_TO_LINT(UDINT_TO_DINT(CalibrationRightPosition))
		- DINT_TO_LINT(UDINT_TO_DINT(CalibrationLeftPosition));
	IF CalibrationPositionDelta < 0 THEN
		CalibrationPositionDelta := -CalibrationPositionDelta;
	END_IF
	IF CalibrationPositionDelta > 0 THEN
		CalibrationPositionDifferenceIncrements := LINT_TO_UDINT(CalibrationPositionDelta);
		CalibrationFullStepDifference := TO_REAL(CalibrationPositionDifferenceIncrements) / 64.0;
		GuiConveyorMmPerFullStep := GuiCalibrationMarkerDistanceMm / CalibrationFullStepDifference;
		CalibrationStepsPerMm := 1.0 / GuiConveyorMmPerFullStep;
		GuiConveyorCalibrationValid := TRUE;
	ELSE
		CalibrationPositionDifferenceIncrements := 0;
		CalibrationFullStepDifference := 0.0;
		CalibrationStatusCode := 4;
	END_IF
END_IF

// Convert the physical speed request to the 0..10000 positioning-interface velocity range.
IF GuiConveyorCalibrationValid AND (GuiConveyorMmPerFullStep > 0.0) THEN
	ConveyorFullStepsPerSec := ConveyorSpeedMmPerSec / GuiConveyorMmPerFullStep;
	ConveyorVelocityRatio := ConveyorFullStepsPerSec / ConveyorSpeedRangeFullStepsPerSec;
ELSE
	ConveyorFullStepsPerSec := 0.0;
	ConveyorVelocityRatio := ConveyorSpeedMmPerSec / GuiConveyorMaxSpeedMmPerSec;
END_IF
IF ConveyorVelocityRatio < 0.0 THEN
	ConveyorVelocityRatio := 0.0;
ELSIF ConveyorVelocityRatio > 1.0 THEN
	ConveyorVelocityRatio := 1.0;
END_IF
ConveyorVelocityRaw := REAL_TO_INT(ConveyorVelocityRatio * 10000.0);

// A calibration move is a finite relative positioning command in motor full steps.
IF GuiCalibrationMoveLeft OR GuiCalibrationMoveRight THEN
	IF GuiConveyorCalibrationMode
		AND (ConveyorMotionState = 0)
		AND NOT StepperPosBusy
		AND StepperPosReadyToExecute
		AND (GuiCalibrationMoveLeft <> GuiCalibrationMoveRight) THEN
		CalibrationTargetIncrements := UDINT_TO_DINT(GuiCalibrationJogSteps * UDINT#64);
		CalibrationDirectionNegative := GuiCalibrationMoveLeft;
		IF GuiConveyorReverse THEN
			CalibrationDirectionNegative := NOT CalibrationDirectionNegative;
		END_IF
		IF CalibrationDirectionNegative THEN
			CalibrationTargetIncrements := -CalibrationTargetIncrements;
		END_IF
		ConveyorActiveVelocity := REAL_TO_INT(
			GuiCalibrationJogSpeedFullStepsPerSec / ConveyorSpeedRangeFullStepsPerSec * 10000.0);
		IF ConveyorActiveVelocity < 1 THEN
			ConveyorActiveVelocity := 1;
		ELSIF ConveyorActiveVelocity > 10000 THEN
			ConveyorActiveVelocity := 10000;
		END_IF
		ConveyorActiveStartType := 2; //RELATIVE
		// Keep the cyclic command words at zero until the positioning interface reports ready.
		StepperPosTargetPosition := 0;
		StepperPosVelocity := 0;
		StepperPosStartType := 0;
		ConveyorMotionMode := 2;
		ConveyorMotionState := 10;
		CalibrationStatusCode := 1;
	ELSE
		CalibrationStatusCode := 4;
	END_IF
	GuiCalibrationMoveLeft := FALSE;
	GuiCalibrationMoveRight := FALSE;
END_IF

// One state machine owns all positioning-interface commands.
CASE ConveyorMotionState OF
	0:
		StepperPosExecute := FALSE;
		StepperPosEmergencyStop := FALSE;
		StepperPosTargetPosition := 0;
		StepperPosVelocity := 0;
		StepperPosStartType := 0;
		StepperPosAcceleration := 1000;
		StepperPosDeceleration := 1000;
		ConveyorMotionMode := 0;
		IF GuiConveyorEnabled AND NOT GuiConveyorCalibrationMode AND (ConveyorVelocityRaw > 0) THEN
			IF GuiConveyorReverse THEN
				ConveyorActiveStartType := 4; //ENDLESS_MINUS
			ELSE
				ConveyorActiveStartType := 3; //ENDLESS_PLUS
			END_IF
			ConveyorActiveVelocity := ConveyorVelocityRaw;
			ConveyorMotionMode := 1;
			ConveyorMotionState := 10;
		END_IF

	10:
		StepperPosExecute := FALSE;
		IF StepperPosError THEN
			ConveyorMotionState := 50;
			CalibrationStatusCode := 5;
		ELSIF GuiCalibrationStop
			OR ((ConveyorMotionMode = 2) AND NOT GuiConveyorCalibrationMode)
			OR ((ConveyorMotionMode = 1) AND ((NOT GuiConveyorEnabled) OR GuiConveyorCalibrationMode)) THEN
			StepperPosEmergencyStop := TRUE;
			ConveyorMotionState := 40;
		ELSIF StepperPosReadyToExecute THEN
			IF ConveyorMotionMode = 2 THEN
				StepperPosTargetPosition := DINT_TO_UDINT(CalibrationTargetIncrements);
			ELSE
				StepperPosTargetPosition := 0;
			END_IF
			StepperPosVelocity := ConveyorActiveVelocity;
			StepperPosStartType := ConveyorActiveStartType;
			StepperPosAcceleration := 1000;
			StepperPosDeceleration := 1000;
			StepperPosExecute := TRUE;
			ConveyorMotionState := 20;
		END_IF

	20:
		StepperPosExecute := TRUE;
		IF StepperPosError THEN
			StepperPosExecute := FALSE;
			ConveyorMotionState := 50;
			CalibrationStatusCode := 5;
		ELSIF GuiCalibrationStop
			OR ((ConveyorMotionMode = 2) AND NOT GuiConveyorCalibrationMode)
			OR ((ConveyorMotionMode = 1) AND ((NOT GuiConveyorEnabled) OR GuiConveyorCalibrationMode)) THEN
			StepperPosEmergencyStop := TRUE;
			StepperPosExecute := FALSE;
			ConveyorMotionState := 40;
		ELSIF StepperPosBusy THEN
			ConveyorMotionState := 30;
			IF ConveyorMotionMode = 2 THEN
				CalibrationStatusCode := 2;
			END_IF
		END_IF

	30:
		StepperPosExecute := TRUE;
		IF StepperPosError THEN
			StepperPosExecute := FALSE;
			ConveyorMotionState := 50;
			CalibrationStatusCode := 5;
		ELSIF GuiCalibrationStop OR ((ConveyorMotionMode = 2) AND NOT GuiConveyorCalibrationMode) THEN
			StepperPosEmergencyStop := TRUE;
			StepperPosExecute := FALSE;
			ConveyorMotionState := 40;
		ELSIF ConveyorMotionMode = 2 THEN
			IF NOT StepperPosBusy THEN
				StepperPosExecute := FALSE;
				ConveyorMotionState := 0;
				ConveyorMotionMode := 0;
				CalibrationStatusCode := 3;
			END_IF
		ELSIF (NOT GuiConveyorEnabled)
			OR GuiConveyorCalibrationMode
			OR (ConveyorVelocityRaw <> ConveyorActiveVelocity)
			OR ((GuiConveyorReverse AND (ConveyorActiveStartType <> 4))
				OR ((NOT GuiConveyorReverse) AND (ConveyorActiveStartType <> 3))) THEN
			StepperPosExecute := FALSE;
			ConveyorMotionState := 40;
		ELSIF NOT StepperPosBusy THEN
			StepperPosExecute := FALSE;
			ConveyorMotionState := 0;
			ConveyorMotionMode := 0;
		END_IF

	40:
		StepperPosExecute := FALSE;
		IF NOT StepperPosBusy THEN
			StepperPosEmergencyStop := FALSE;
			ConveyorMotionState := 0;
			ConveyorMotionMode := 0;
		END_IF

	50:
		StepperPosExecute := FALSE;
		StepperPosEmergencyStop := FALSE;
		IF NOT StepperPosError THEN
			ConveyorMotionState := 0;
			ConveyorMotionMode := 0;
		END_IF
ELSE
	ConveyorMotionState := 0;
	ConveyorMotionMode := 0;
	StepperPosExecute := FALSE;
	StepperPosEmergencyStop := FALSE;
END_CASE

CalibrationBusy := (ConveyorMotionMode = 2) AND (ConveyorMotionState <> 0);
CalibrationError := StepperPosError;
StepperControlEnable := GuiConveyorCalibrationMode OR GuiConveyorEnabled OR (ConveyorMotionState <> 0);
StepperControlReset := GuiConveyorReset;
GuiConveyorReset := FALSE;
StepperControlReduceTorque := StepperControlEnable AND (ConveyorMotionState = 0) AND NOT StepperPosBusy;
StepperControlDigitalOutput1 := FALSE;
BarrierCalibrationAbortRequested := GuiCalibrationStop
	OR NOT GuiConveyorCalibrationMode
	OR StepperPosError;
GuiCalibrationStop := FALSE;

LightBarrier1FallingEdge := (NOT LightBarrierStable1) AND LastLightBarrier1;
LightBarrier2FallingEdge := (NOT LightBarrierStable2) AND LastLightBarrier2;
LightBarrier3FallingEdge := (NOT LightBarrierStable3) AND LastLightBarrier3;
LightBarrier4FallingEdge := (NOT LightBarrierStable4) AND LastLightBarrier4;
LightBarrier5FallingEdge := (NOT LightBarrierStable5) AND LastLightBarrier5;
LightBarrier6FallingEdge := (NOT LightBarrierStable6) AND LastLightBarrier6;
LightBarrier7FallingEdge := (NOT LightBarrierStable7) AND LastLightBarrier7;
LightBarrier8FallingEdge := (NOT LightBarrierStable8) AND LastLightBarrier8;

// Alternating pair gate. A workpiece can expose more than one optical edge at
// either barrier. After the first barrier fires, only the second barrier can
// release it; after the second fires, only the next accepted first-barrier edge
// can release it. Both locks also expire after 500 ms. Raw/stable transitions
// above remain available unchanged for diagnostics and calibration.
FOR BatchLoopIndex := 1 TO 4 DO
	IF PairedFirstBarrierLocked[BatchLoopIndex]
		AND ((LightBarrierEventClockMs - PairedFirstBarrierLockStartMs[BatchLoopIndex])
			>= PairedBarrierLockTimeoutMs) THEN
		PairedFirstBarrierLocked[BatchLoopIndex] := FALSE;
	END_IF
	IF PairedSecondBarrierLocked[BatchLoopIndex]
		AND ((LightBarrierEventClockMs - PairedSecondBarrierLockStartMs[BatchLoopIndex])
			>= PairedBarrierLockTimeoutMs) THEN
		PairedSecondBarrierLocked[BatchLoopIndex] := FALSE;
	END_IF
END_FOR

// Evaluate the second barrier first. This lets a simultaneous second edge for
// the old workpiece release the first edge of the following workpiece.
PairedSecondBarrierFalling[1] := LightBarrier2FallingEdge AND NOT PairedSecondBarrierLocked[1];
PairedSecondBarrierFalling[2] := LightBarrier4FallingEdge AND NOT PairedSecondBarrierLocked[2];
PairedSecondBarrierFalling[3] := LightBarrier6FallingEdge AND NOT PairedSecondBarrierLocked[3];
PairedSecondBarrierFalling[4] := LightBarrier8FallingEdge AND NOT PairedSecondBarrierLocked[4];

FOR BatchLoopIndex := 1 TO 4 DO
	IF PairedSecondBarrierFalling[BatchLoopIndex] THEN
		PairedSecondBarrierLocked[BatchLoopIndex] := TRUE;
		PairedSecondBarrierLockStartMs[BatchLoopIndex] := LightBarrierEventClockMs;
		PairedFirstBarrierLocked[BatchLoopIndex] := FALSE;
	END_IF
END_FOR

PairedFirstBarrierFalling[1] := LightBarrier1FallingEdge AND NOT PairedFirstBarrierLocked[1];
PairedFirstBarrierFalling[2] := LightBarrier3FallingEdge AND NOT PairedFirstBarrierLocked[2];
PairedFirstBarrierFalling[3] := LightBarrier5FallingEdge AND NOT PairedFirstBarrierLocked[3];
PairedFirstBarrierFalling[4] := LightBarrier7FallingEdge AND NOT PairedFirstBarrierLocked[4];

FOR BatchLoopIndex := 1 TO 4 DO
	IF PairedFirstBarrierFalling[BatchLoopIndex] THEN
		PairedFirstBarrierLocked[BatchLoopIndex] := TRUE;
		PairedFirstBarrierLockStartMs[BatchLoopIndex] := LightBarrierEventClockMs;
		PairedSecondBarrierLocked[BatchLoopIndex] := FALSE;
	END_IF
END_FOR

// Production-run ownership.  State 20 accepts parts continuously; state 30
// refuses new commits and drains the already accepted queue.
IF GuiReorientationControlActive AND (ReorientationState = 0) THEN
	ReorientationState := 10;
END_IF
IF GuiReorientationControlActive AND GuiReorientationStart AND (ReorientationState = 10) AND ReorientationHeartbeatAlive AND NOT ReorientationSafeLatch THEN
	ReorientationExpectedArrayMask := 0;
	ReorientationTriggeredArrayMask := 0;
	ReorientationExitSeen := FALSE;
	ReorientationComplete := FALSE;
	ReorientationState := 20;
END_IF

IF GuiReorientationControlActive AND GuiReorientationFinish AND (ReorientationState = 20) THEN
	ReorientationState := 30;
END_IF

// Atomic producer commit.  Sequence IDs must be contiguous and an unacknowledged
// result keeps its ring slot occupied, preventing silent overwrite.
IF GuiReorientationControlActive AND (ReorientationState = 20)
	AND (GuiReorientationQueueCommit <> BatchLastAcceptedCommit) THEN
	IF (GuiReorientationQueueCommit <> (ReorientationQueueEnqueueAck + 1))
		OR (GuiReorientationQueueSequence <> GuiReorientationQueueCommit) THEN
		ReorientationFaultCode := 92;
		ReorientationState := 92;
		ReorientationSafeLatch := TRUE;
	ELSIF (ReorientationQueueEnqueueAck - BatchAcceptedResultAck) >= 128 THEN
		ReorientationFaultCode := 93;
		ReorientationState := 93;
		ReorientationSafeLatch := TRUE;
	ELSE
		BatchSlotIndex := UDINT_TO_INT((GuiReorientationQueueSequence - 1) MOD 128);
		BatchQueueSequence[BatchSlotIndex] := GuiReorientationQueueSequence;
		BatchQueueTrackId[BatchSlotIndex] := GuiReorientationQueueTrackId;
		BatchQueuePoseId[BatchSlotIndex] := GuiReorientationQueuePoseId;
		BatchQueueDecisionCode[BatchSlotIndex] := GuiReorientationQueueDecisionCode;
		BatchQueueArrayMask[BatchSlotIndex] := GuiReorientationQueueArrayMask AND BYTE#15;
		BatchQueueNozzleMask[BatchSlotIndex, 1] := GuiReorientationQueueNozzleMask1 AND BYTE#63;
		BatchQueueNozzleMask[BatchSlotIndex, 2] := GuiReorientationQueueNozzleMask2 AND BYTE#63;
		BatchQueueNozzleMask[BatchSlotIndex, 3] := GuiReorientationQueueNozzleMask3 AND BYTE#63;
		BatchQueueNozzleMask[BatchSlotIndex, 4] := GuiReorientationQueueNozzleMask4 AND BYTE#63;
		BatchQueuePressureMbar[BatchSlotIndex, 1] := GuiReorientationQueuePressureMbar1;
		BatchQueuePressureMbar[BatchSlotIndex, 2] := GuiReorientationQueuePressureMbar2;
		BatchQueuePressureMbar[BatchSlotIndex, 3] := GuiReorientationQueuePressureMbar3;
		BatchQueuePressureMbar[BatchSlotIndex, 4] := GuiReorientationQueuePressureMbar4;
		BatchQueueDelayMs[BatchSlotIndex, 1] := GuiReorientationQueueDelayMs1;
		BatchQueueDelayMs[BatchSlotIndex, 2] := GuiReorientationQueueDelayMs2;
		BatchQueueDelayMs[BatchSlotIndex, 3] := GuiReorientationQueueDelayMs3;
		BatchQueueDelayMs[BatchSlotIndex, 4] := GuiReorientationQueueDelayMs4;
		BatchQueuePulseMs[BatchSlotIndex, 1] := GuiReorientationQueuePulseMs1;
		BatchQueuePulseMs[BatchSlotIndex, 2] := GuiReorientationQueuePulseMs2;
		BatchQueuePulseMs[BatchSlotIndex, 3] := GuiReorientationQueuePulseMs3;
		BatchQueuePulseMs[BatchSlotIndex, 4] := GuiReorientationQueuePulseMs4;
		BatchQueueOffsetMm[BatchSlotIndex, 1] := GuiReorientationQueueOffsetMm1;
		BatchQueueOffsetMm[BatchSlotIndex, 2] := GuiReorientationQueueOffsetMm2;
		BatchQueueOffsetMm[BatchSlotIndex, 3] := GuiReorientationQueueOffsetMm3;
		BatchQueueOffsetMm[BatchSlotIndex, 4] := GuiReorientationQueueOffsetMm4;
		BatchQueueForceResponseMs[BatchSlotIndex, 1] := GuiReorientationQueueForceResponseMs1;
		BatchQueueForceResponseMs[BatchSlotIndex, 2] := GuiReorientationQueueForceResponseMs2;
		BatchQueueForceResponseMs[BatchSlotIndex, 3] := GuiReorientationQueueForceResponseMs3;
		BatchQueueForceResponseMs[BatchSlotIndex, 4] := GuiReorientationQueueForceResponseMs4;
		BatchQueueForceSingleMs[BatchSlotIndex, 1] := GuiReorientationQueueForceSingleMs1;
		BatchQueueForceSingleMs[BatchSlotIndex, 2] := GuiReorientationQueueForceSingleMs2;
		BatchQueueForceSingleMs[BatchSlotIndex, 3] := GuiReorientationQueueForceSingleMs3;
		BatchQueueForceSingleMs[BatchSlotIndex, 4] := GuiReorientationQueueForceSingleMs4;
		BatchQueueTriggeredMask[BatchSlotIndex] := 0;
		BatchQueueActuatedMask[BatchSlotIndex] := 0;
		BatchQueueFinishedMask[BatchSlotIndex] := (NOT BatchQueueArrayMask[BatchSlotIndex]) AND BYTE#15;
		BatchQueueExitSeen[BatchSlotIndex] := FALSE;
		BatchLastAcceptedCommit := GuiReorientationQueueCommit;
		ReorientationQueueEnqueueAck := GuiReorientationQueueSequence;
	END_IF
END_IF

IF GuiReorientationControlActive AND ((ReorientationState = 20) OR (ReorientationState = 30))
	AND (GuiReorientationResultAck <> BatchAcceptedResultAck) THEN
	IF (GuiReorientationResultAck = (BatchAcceptedResultAck + 1))
		AND (GuiReorientationResultAck <= ReorientationQueueCompletedCount) THEN
		BatchAcceptedResultAck := GuiReorientationResultAck;
	ELSE
		ReorientationFaultCode := 92; // invalid or out-of-order result acknowledgement
		ReorientationState := 92;
		ReorientationSafeLatch := TRUE;
	END_IF
END_IF

IF ReorientationQueueEnqueueAck >= BatchAcceptedResultAck THEN
	ReorientationQueueDepth := UDINT_TO_UINT(ReorientationQueueEnqueueAck - BatchAcceptedResultAck);
ELSE
	ReorientationQueueDepth := 0;
END_IF

// Record every accepted stable transition at PLC-cycle resolution for ADS diagnostics.
IF LightBarrierStable1 <> LastLightBarrier1 THEN
	LightBarrierEventCount1 := LightBarrierEventCount1 + 1;
	LightBarrierLastEventTimeMs1 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition1 := StepperInternalPosition;
END_IF
IF LightBarrierStable2 <> LastLightBarrier2 THEN
	LightBarrierEventCount2 := LightBarrierEventCount2 + 1;
	LightBarrierLastEventTimeMs2 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition2 := StepperInternalPosition;
END_IF
IF LightBarrierStable3 <> LastLightBarrier3 THEN
	LightBarrierEventCount3 := LightBarrierEventCount3 + 1;
	LightBarrierLastEventTimeMs3 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition3 := StepperInternalPosition;
END_IF
IF LightBarrierStable4 <> LastLightBarrier4 THEN
	LightBarrierEventCount4 := LightBarrierEventCount4 + 1;
	LightBarrierLastEventTimeMs4 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition4 := StepperInternalPosition;
END_IF
IF LightBarrierStable5 <> LastLightBarrier5 THEN
	LightBarrierEventCount5 := LightBarrierEventCount5 + 1;
	LightBarrierLastEventTimeMs5 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition5 := StepperInternalPosition;
END_IF
IF LightBarrierStable6 <> LastLightBarrier6 THEN
	LightBarrierEventCount6 := LightBarrierEventCount6 + 1;
	LightBarrierLastEventTimeMs6 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition6 := StepperInternalPosition;
END_IF
IF LightBarrierStable7 <> LastLightBarrier7 THEN
	LightBarrierEventCount7 := LightBarrierEventCount7 + 1;
	LightBarrierLastEventTimeMs7 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition7 := StepperInternalPosition;
END_IF
IF LightBarrierStable8 <> LastLightBarrier8 THEN
	LightBarrierEventCount8 := LightBarrierEventCount8 + 1;
	LightBarrierLastEventTimeMs8 := LightBarrierEventClockMs;
	LightBarrierLastEventPosition8 := StepperInternalPosition;
END_IF

// Continuous part cursor. Every sensor sees sequence 1, 2, 3, ... in exactly
// that order. Odd barriers capture time; the following even barrier creates an
// immutable array job and computes its final offset delay from that same part.
BatchSensorFalling[1] := PairedFirstBarrierFalling[1];
BatchSensorFalling[2] := PairedSecondBarrierFalling[1];
BatchSensorFalling[3] := PairedFirstBarrierFalling[2];
BatchSensorFalling[4] := PairedSecondBarrierFalling[2];
BatchSensorFalling[5] := PairedFirstBarrierFalling[3];
BatchSensorFalling[6] := PairedSecondBarrierFalling[3];
BatchSensorFalling[7] := PairedFirstBarrierFalling[4];
BatchSensorFalling[8] := PairedSecondBarrierFalling[4];
BatchSensorStable[1] := LightBarrierStable1;
BatchSensorStable[2] := LightBarrierStable2;
BatchSensorStable[3] := LightBarrierStable3;
BatchSensorStable[4] := LightBarrierStable4;
BatchSensorStable[5] := LightBarrierStable5;
BatchSensorStable[6] := LightBarrierStable6;
BatchSensorStable[7] := LightBarrierStable7;
BatchSensorStable[8] := LightBarrierStable8;
BatchCurrentBarrierStableMask := BYTE#0;
IF BatchSensorStable[1] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#1; END_IF
IF BatchSensorStable[2] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#2; END_IF
IF BatchSensorStable[3] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#4; END_IF
IF BatchSensorStable[4] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#8; END_IF
IF BatchSensorStable[5] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#16; END_IF
IF BatchSensorStable[6] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#32; END_IF
IF BatchSensorStable[7] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#64; END_IF
IF BatchSensorStable[8] THEN BatchCurrentBarrierStableMask := BatchCurrentBarrierStableMask OR BYTE#128; END_IF
BatchPairSpacingMm[1] := GuiSensorSpacing12Mm;
BatchPairSpacingMm[2] := GuiSensorSpacing34Mm;
BatchPairSpacingMm[3] := GuiSensorSpacing56Mm;
BatchPairSpacingMm[4] := GuiSensorSpacing78Mm;

IF GuiReorientationControlActive AND ((ReorientationState = 20) OR (ReorientationState = 30)) THEN
	FOR BatchLoopIndex := 1 TO 8 DO
		IF BatchSensorStable[BatchLoopIndex] THEN
			BatchSensorNeedsClear[BatchLoopIndex] := FALSE;
		END_IF
		IF BatchSensorFalling[BatchLoopIndex] THEN
			ReorientationFaultSensor := INT_TO_UINT(BatchLoopIndex);
			ReorientationFaultExpectedSequence := BatchNextSensorSequence[BatchLoopIndex];
			ReorientationFaultPreviousSequence := 0;
			ReorientationFaultQueueAck := ReorientationQueueEnqueueAck;
			ReorientationFaultBarrierStableMask := BatchCurrentBarrierStableMask;
			IF BatchSensorNeedsClear[BatchLoopIndex] THEN
				ReorientationFaultDetail := 1;
				ReorientationFaultQueueSlotSequence := 0;
				// Diagnostic mode: reject the ambiguous edge but keep production
				// running. Never advance a cursor or trigger a nozzle from it.
				ReorientationWarningCode := 3;
				ReorientationWarningSensor := INT_TO_UINT(BatchLoopIndex);
				ReorientationWarningSequence := BatchNextSensorSequence[BatchLoopIndex];
				ReorientationWarningPreviousSequence := 0;
				ReorientationWarningSkippedBarrierMask := BYTE#0;
				ReorientationWarningCounter := ReorientationWarningCounter + 1;
				IF (BatchLoopIndex MOD 2) = 1 THEN
					BatchJobIndex := (BatchLoopIndex + 1) / 2;
					PairedFirstBarrierLocked[BatchJobIndex] := TRUE;
					PairedFirstBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
					PairedSecondBarrierLocked[BatchJobIndex] := FALSE;
				ELSE
					BatchJobIndex := BatchLoopIndex / 2;
					PairedSecondBarrierLocked[BatchJobIndex] := TRUE;
					PairedSecondBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
					PairedFirstBarrierLocked[BatchJobIndex] := FALSE;
				END_IF
			ELSE
				BatchSensorNeedsClear[BatchLoopIndex] := TRUE;
				BatchSlotIndex := UDINT_TO_INT((BatchNextSensorSequence[BatchLoopIndex] - 1) MOD 128);
				// A normal TwinCAT AND does not guarantee short-circuit evaluation.
				// Never form BatchSensorSequence[0] while processing sensor 1.
				BatchSensorOrderInvalid := FALSE;
				BatchCanResyncSkippedSensors := FALSE;
				BatchCurrentFlightConfirmed := FALSE;
				BatchIgnoreAirborneDuplicate := FALSE;
				BatchLastRequiredSensor := 0;
				BatchLastRequiredArrayMask := BYTE#0;
				BatchPreviousLastRequiredSensor := 0;
				BatchPreviousLastRequiredArrayMask := BYTE#0;
				IF BatchLoopIndex > 1 THEN
					ReorientationFaultPreviousSequence := BatchSensorSequence[BatchLoopIndex - 1];
					BatchSensorOrderInvalid :=
						BatchSensorSequence[BatchLoopIndex - 1] < BatchNextSensorSequence[BatchLoopIndex];
					// The highest enabled array defines the final sensor pair that
					// remains timing/actuation-critical for this queued part.
					IF (BatchQueueArrayMask[BatchSlotIndex] AND BYTE#8) <> BYTE#0 THEN
						BatchLastRequiredSensor := 8;
						BatchLastRequiredArrayMask := BYTE#8;
					ELSIF (BatchQueueArrayMask[BatchSlotIndex] AND BYTE#4) <> BYTE#0 THEN
						BatchLastRequiredSensor := 6;
						BatchLastRequiredArrayMask := BYTE#4;
					ELSIF (BatchQueueArrayMask[BatchSlotIndex] AND BYTE#2) <> BYTE#0 THEN
						BatchLastRequiredSensor := 4;
						BatchLastRequiredArrayMask := BYTE#2;
					ELSIF (BatchQueueArrayMask[BatchSlotIndex] AND BYTE#1) <> BYTE#0 THEN
						BatchLastRequiredSensor := 2;
						BatchLastRequiredArrayMask := BYTE#1;
					END_IF
					BatchCurrentFlightConfirmed :=
						(BatchLastRequiredArrayMask <> BYTE#0)
						AND ((BatchQueueActuatedMask[BatchSlotIndex]
							AND BatchLastRequiredArrayMask) <> BYTE#0);
					BatchCanResyncSkippedSensors := BatchSensorOrderInvalid
						AND ((BatchLoopIndex - 1) > BatchLastRequiredSensor)
						AND BatchCurrentFlightConfirmed;

					// If this exact part has not yet been actuated, an edge behind the
					// final array of the still-airborne previous part is its duplicate,
					// not permission to advance the next queue sequence.
					IF BatchSensorOrderInvalid
						AND NOT BatchCanResyncSkippedSensors
						AND (BatchNextSensorSequence[BatchLoopIndex] > 1) THEN
						BatchPreviousSlotIndex := UDINT_TO_INT(
							(BatchNextSensorSequence[BatchLoopIndex] - 2) MOD 128);
						IF (BatchQueueArrayMask[BatchPreviousSlotIndex] AND BYTE#8) <> BYTE#0 THEN
							BatchPreviousLastRequiredSensor := 8;
							BatchPreviousLastRequiredArrayMask := BYTE#8;
						ELSIF (BatchQueueArrayMask[BatchPreviousSlotIndex] AND BYTE#4) <> BYTE#0 THEN
							BatchPreviousLastRequiredSensor := 6;
							BatchPreviousLastRequiredArrayMask := BYTE#4;
						ELSIF (BatchQueueArrayMask[BatchPreviousSlotIndex] AND BYTE#2) <> BYTE#0 THEN
							BatchPreviousLastRequiredSensor := 4;
							BatchPreviousLastRequiredArrayMask := BYTE#2;
						ELSIF (BatchQueueArrayMask[BatchPreviousSlotIndex] AND BYTE#1) <> BYTE#0 THEN
							BatchPreviousLastRequiredSensor := 2;
							BatchPreviousLastRequiredArrayMask := BYTE#1;
						END_IF
						BatchIgnoreAirborneDuplicate :=
							(BatchQueueSequence[BatchPreviousSlotIndex]
								= (BatchNextSensorSequence[BatchLoopIndex] - 1))
							AND NOT BatchQueueExitSeen[BatchPreviousSlotIndex]
							AND (BatchPreviousLastRequiredArrayMask <> BYTE#0)
							AND ((BatchQueueActuatedMask[BatchPreviousSlotIndex]
								AND BatchPreviousLastRequiredArrayMask) <> BYTE#0)
							AND (BatchLoopIndex > BatchPreviousLastRequiredSensor);
					END_IF
				END_IF
				ReorientationFaultQueueSlotSequence := BatchQueueSequence[BatchSlotIndex];
				IF (BatchNextSensorSequence[BatchLoopIndex] > ReorientationQueueEnqueueAck)
					OR (BatchQueueSequence[BatchSlotIndex] <> BatchNextSensorSequence[BatchLoopIndex]) THEN
					ReorientationFaultDetail := 2;
					ReorientationWarningCode := 4;
					ReorientationWarningSensor := INT_TO_UINT(BatchLoopIndex);
					ReorientationWarningSequence := BatchNextSensorSequence[BatchLoopIndex];
					ReorientationWarningPreviousSequence := ReorientationFaultPreviousSequence;
					ReorientationWarningSkippedBarrierMask := BYTE#0;
					ReorientationWarningCounter := ReorientationWarningCounter + 1;
					IF (BatchLoopIndex MOD 2) = 1 THEN
						BatchJobIndex := (BatchLoopIndex + 1) / 2;
						PairedFirstBarrierLocked[BatchJobIndex] := TRUE;
						PairedFirstBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
						PairedSecondBarrierLocked[BatchJobIndex] := FALSE;
					ELSE
						BatchJobIndex := BatchLoopIndex / 2;
						PairedSecondBarrierLocked[BatchJobIndex] := TRUE;
						PairedSecondBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
						PairedFirstBarrierLocked[BatchJobIndex] := FALSE;
					END_IF
				ELSIF BatchIgnoreAirborneDuplicate THEN
					// The partner gate admitted another optical edge from the already
					// actuated previous part. Keep the current cursor unchanged and
					// restart this sensor's inhibit instead of faulting or misassigning it.
					ReorientationWarningCode := 2;
					ReorientationWarningSensor := INT_TO_UINT(BatchLoopIndex);
					ReorientationWarningSequence := BatchNextSensorSequence[BatchLoopIndex];
					ReorientationWarningPreviousSequence :=
						BatchNextSensorSequence[BatchLoopIndex] - 1;
					ReorientationWarningSkippedBarrierMask := BYTE#0;
					ReorientationWarningCounter := ReorientationWarningCounter + 1;
					IF (BatchLoopIndex MOD 2) = 1 THEN
						BatchJobIndex := (BatchLoopIndex + 1) / 2;
						PairedFirstBarrierLocked[BatchJobIndex] := TRUE;
						PairedFirstBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
						PairedSecondBarrierLocked[BatchJobIndex] := FALSE;
					ELSE
						BatchJobIndex := BatchLoopIndex / 2;
						PairedSecondBarrierLocked[BatchJobIndex] := TRUE;
						PairedSecondBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
						PairedFirstBarrierLocked[BatchJobIndex] := FALSE;
					END_IF
				ELSIF BatchSensorOrderInvalid AND NOT BatchCanResyncSkippedSensors THEN
					ReorientationFaultDetail := 3;
					ReorientationWarningCode := 5;
					ReorientationWarningSensor := INT_TO_UINT(BatchLoopIndex);
					ReorientationWarningSequence := BatchNextSensorSequence[BatchLoopIndex];
					ReorientationWarningPreviousSequence := ReorientationFaultPreviousSequence;
					ReorientationWarningSkippedBarrierMask := BYTE#0;
					ReorientationWarningCounter := ReorientationWarningCounter + 1;
					IF (BatchLoopIndex MOD 2) = 1 THEN
						BatchJobIndex := (BatchLoopIndex + 1) / 2;
						PairedFirstBarrierLocked[BatchJobIndex] := TRUE;
						PairedFirstBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
						PairedSecondBarrierLocked[BatchJobIndex] := FALSE;
					ELSE
						BatchJobIndex := BatchLoopIndex / 2;
						PairedSecondBarrierLocked[BatchJobIndex] := TRUE;
						PairedSecondBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
						PairedFirstBarrierLocked[BatchJobIndex] := FALSE;
					END_IF
				ELSE
					IF BatchCanResyncSkippedSensors THEN
						BatchSkippedBarrierMask := BYTE#0;
						FOR BatchResyncIndex := BatchLastRequiredSensor + 1 TO BatchLoopIndex - 1 DO
							IF BatchSensorSequence[BatchResyncIndex]
								< BatchNextSensorSequence[BatchLoopIndex] THEN
								BatchSensorSequence[BatchResyncIndex] :=
									BatchNextSensorSequence[BatchLoopIndex];
								BatchNextSensorSequence[BatchResyncIndex] :=
									BatchNextSensorSequence[BatchLoopIndex] + 1;
								BatchSensorNeedsClear[BatchResyncIndex] := FALSE;
								BatchSkippedBarrierMask := BatchSkippedBarrierMask
									OR SHL(BYTE#1, BatchResyncIndex - 1);
								// Advance the alternating pair gate just as the virtual sensor
								// acceptance advances its sequence cursor.
								IF (BatchResyncIndex MOD 2) = 1 THEN
									BatchJobIndex := (BatchResyncIndex + 1) / 2;
									PairedFirstBarrierLocked[BatchJobIndex] := TRUE;
									PairedFirstBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
									PairedSecondBarrierLocked[BatchJobIndex] := FALSE;
								ELSE
									BatchJobIndex := BatchResyncIndex / 2;
									PairedSecondBarrierLocked[BatchJobIndex] := TRUE;
									PairedSecondBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
									PairedFirstBarrierLocked[BatchJobIndex] := FALSE;
								END_IF
							END_IF
						END_FOR
						// The physical current edge was evaluated before the virtual ones;
						// re-apply it last so a skipped odd sensor in the same pair cannot
						// overwrite the correct final gate phase.
						IF (BatchLoopIndex MOD 2) = 1 THEN
							BatchJobIndex := (BatchLoopIndex + 1) / 2;
							PairedFirstBarrierLocked[BatchJobIndex] := TRUE;
							PairedFirstBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
							PairedSecondBarrierLocked[BatchJobIndex] := FALSE;
						ELSE
							BatchJobIndex := BatchLoopIndex / 2;
							PairedSecondBarrierLocked[BatchJobIndex] := TRUE;
							PairedSecondBarrierLockStartMs[BatchJobIndex] := LightBarrierEventClockMs;
							PairedFirstBarrierLocked[BatchJobIndex] := FALSE;
						END_IF
						ReorientationWarningCode := 1;
						ReorientationWarningSensor := INT_TO_UINT(BatchLoopIndex);
						ReorientationWarningSequence := BatchNextSensorSequence[BatchLoopIndex];
						ReorientationWarningPreviousSequence := ReorientationFaultPreviousSequence;
						ReorientationWarningSkippedBarrierMask := BatchSkippedBarrierMask;
						ReorientationWarningCounter := ReorientationWarningCounter + 1;
					END_IF
					BatchSensorSequence[BatchLoopIndex] := BatchNextSensorSequence[BatchLoopIndex];
					IF (BatchLoopIndex MOD 2) = 1 THEN
						BatchJobIndex := (BatchLoopIndex + 1) / 2;
						BatchQueuePairStartMs[BatchSlotIndex, BatchJobIndex] := LightBarrierEventClockMs;
						IF BatchLoopIndex = 1 THEN
							ReorientationQueueEnteredCount := ReorientationQueueEnteredCount + 1;
						END_IF
					ELSE
						BatchJobIndex := BatchLoopIndex / 2;
						IF (BatchQueueArrayMask[BatchSlotIndex] AND SHL(BYTE#1, BatchJobIndex - 1)) <> BYTE#0 THEN
							IF BatchJobCount[BatchJobIndex] >= 16 THEN
								ReorientationFaultCode := 95; // per-array job FIFO overflow
								ReorientationState := 95;
								ReorientationSafeLatch := TRUE;
							ELSE
								BatchElapsedMs := LightBarrierEventClockMs - BatchQueuePairStartMs[BatchSlotIndex, BatchJobIndex];
								BatchNozzleCount := 0;
								FOR BatchSlotIndex := 0 TO 5 DO
									IF (BatchQueueNozzleMask[UDINT_TO_INT((BatchNextSensorSequence[BatchLoopIndex] - 1) MOD 128), BatchJobIndex]
										AND SHL(BYTE#1, BatchSlotIndex)) <> BYTE#0 THEN
										BatchNozzleCount := BatchNozzleCount + 1;
									END_IF
								END_FOR
								BatchSlotIndex := UDINT_TO_INT((BatchNextSensorSequence[BatchLoopIndex] - 1) MOD 128);
								IF BatchNozzleCount <= 1 THEN
									BatchResponseDelayMs := BatchQueueForceSingleMs[BatchSlotIndex, BatchJobIndex];
								ELSE
									BatchResponseDelayMs := BatchQueueForceResponseMs[BatchSlotIndex, BatchJobIndex];
								END_IF
								BatchComputedDelayMs := UINT_TO_REAL(BatchQueueDelayMs[BatchSlotIndex, BatchJobIndex]);
								IF (BatchElapsedMs > 0) AND (BatchPairSpacingMm[BatchJobIndex] > 0.0)
									AND (BatchQueueOffsetMm[BatchSlotIndex, BatchJobIndex] > 0.0) THEN
									BatchComputedDelayMs := BatchComputedDelayMs
										+ BatchQueueOffsetMm[BatchSlotIndex, BatchJobIndex]
										* UDINT_TO_REAL(BatchElapsedMs) / BatchPairSpacingMm[BatchJobIndex]
										- BatchResponseDelayMs;
								END_IF
								IF BatchComputedDelayMs < 0.0 THEN BatchComputedDelayMs := 0.0; END_IF
								IF BatchComputedDelayMs > 31000.0 THEN BatchComputedDelayMs := 31000.0; END_IF
								BatchJobSequence[BatchJobTail[BatchJobIndex], BatchJobIndex] := BatchQueueSequence[BatchSlotIndex];
								BatchJobNozzleMask[BatchJobTail[BatchJobIndex], BatchJobIndex] := BatchQueueNozzleMask[BatchSlotIndex, BatchJobIndex];
								BatchJobPressureMbar[BatchJobTail[BatchJobIndex], BatchJobIndex] := BatchQueuePressureMbar[BatchSlotIndex, BatchJobIndex];
								BatchJobDelayCycles[BatchJobTail[BatchJobIndex], BatchJobIndex] := REAL_TO_INT(BatchComputedDelayMs);
								BatchJobPulseCycles[BatchJobTail[BatchJobIndex], BatchJobIndex] := UINT_TO_INT(BatchQueuePulseMs[BatchSlotIndex, BatchJobIndex]);
								BatchJobTail[BatchJobIndex] := (BatchJobTail[BatchJobIndex] + 1) MOD 16;
								BatchJobCount[BatchJobIndex] := BatchJobCount[BatchJobIndex] + 1;
								BatchQueueTriggeredMask[BatchSlotIndex] := BatchQueueTriggeredMask[BatchSlotIndex]
									OR SHL(BYTE#1, BatchJobIndex - 1);
							END_IF
						END_IF
						IF BatchLoopIndex = 8 THEN
							BatchQueueExitSeen[BatchSlotIndex] := TRUE;
							ReorientationExitSeen := TRUE;
						END_IF
					END_IF
					BatchNextSensorSequence[BatchLoopIndex] := BatchNextSensorSequence[BatchLoopIndex] + 1;
				END_IF
			END_IF
		END_IF
		// Preserve the first faulting sensor and its context. Without EXIT, a
		// second edge in this same 1-ms scan could overwrite the diagnostics.
		IF ReorientationSafeLatch THEN
			EXIT;
		END_IF
	END_FOR
END_IF

ReorientationSensorSequence1 := BatchSensorSequence[1];
ReorientationSensorSequence2 := BatchSensorSequence[2];
ReorientationSensorSequence3 := BatchSensorSequence[3];
ReorientationSensorSequence4 := BatchSensorSequence[4];
ReorientationSensorSequence5 := BatchSensorSequence[5];
ReorientationSensorSequence6 := BatchSensorSequence[6];
ReorientationSensorSequence7 := BatchSensorSequence[7];
ReorientationSensorSequence8 := BatchSensorSequence[8];

// Accept either signal polarity, but only after the new state remains stable for the debounce time.
// The candidate position is captured on the first cycle of the ultimately stable transition.
IF BarrierCalibrationActive THEN
	IF NOT BarrierCalibrationFirstCaptured THEN
		IF BarrierCalibrationFirstState <> BarrierCalibrationFirstInitialState THEN
			IF BarrierCalibrationFirstStableCycles = 0 THEN
				BarrierCalibrationFirstCandidatePosition := StepperInternalPosition;
			END_IF
			IF BarrierCalibrationFirstStableCycles < GuiBarrierCalibrationDebounceMs THEN
				BarrierCalibrationFirstStableCycles := BarrierCalibrationFirstStableCycles + 1;
			END_IF
			IF BarrierCalibrationFirstStableCycles >= GuiBarrierCalibrationDebounceMs THEN
				BarrierCalibrationFirstPosition := BarrierCalibrationFirstCandidatePosition;
				BarrierCalibrationFirstCaptured := TRUE;
				BarrierCalibrationStatusCode := 2;
			END_IF
		ELSE
			BarrierCalibrationFirstStableCycles := 0;
		END_IF
	ELSIF BarrierCalibrationFirstCaptured
		AND NOT BarrierCalibrationSecondCaptured THEN
		IF BarrierCalibrationSecondState <> BarrierCalibrationSecondInitialState THEN
			IF BarrierCalibrationSecondStableCycles = 0 THEN
				BarrierCalibrationSecondCandidatePosition := StepperInternalPosition;
			END_IF
			IF BarrierCalibrationSecondStableCycles < GuiBarrierCalibrationDebounceMs THEN
				BarrierCalibrationSecondStableCycles := BarrierCalibrationSecondStableCycles + 1;
			END_IF
			IF BarrierCalibrationSecondStableCycles >= GuiBarrierCalibrationDebounceMs THEN
				BarrierCalibrationSecondPosition := BarrierCalibrationSecondCandidatePosition;
				BarrierCalibrationSecondCaptured := TRUE;
				BarrierCalibrationPositionDelta := DINT_TO_LINT(UDINT_TO_DINT(BarrierCalibrationSecondPosition))
					- DINT_TO_LINT(UDINT_TO_DINT(BarrierCalibrationFirstPosition));
				IF BarrierCalibrationPositionDelta < 0 THEN
					BarrierCalibrationPositionDelta := -BarrierCalibrationPositionDelta;
				END_IF
				IF BarrierCalibrationPositionDelta > 0 THEN
					BarrierCalibrationDifferenceIncrements := LINT_TO_UDINT(BarrierCalibrationPositionDelta);
					BarrierCalibrationDistanceMm :=
						TO_REAL(BarrierCalibrationDifferenceIncrements) / 64.0 * GuiConveyorMmPerFullStep;
					BarrierCalibrationValid := TRUE;
					BarrierCalibrationStatusCode := 3;
				ELSE
					BarrierCalibrationDifferenceIncrements := 0;
					BarrierCalibrationDistanceMm := 0.0;
					BarrierCalibrationValid := FALSE;
					BarrierCalibrationStatusCode := 4;
				END_IF
				BarrierCalibrationActive := FALSE;
				GuiCalibrationStop := TRUE;
			END_IF
		ELSE
			BarrierCalibrationSecondStableCycles := 0;
		END_IF
	END_IF
END_IF

// Cancel a measurement if the drive stops before the second selected barrier is reached.
IF BarrierCalibrationActive
	AND (BarrierCalibrationAbortRequested
		OR ((ConveyorMotionState = 0) AND (ConveyorMotionMode = 0))) THEN
	BarrierCalibrationActive := FALSE;
	BarrierCalibrationValid := FALSE;
	IF StepperPosError THEN
		BarrierCalibrationStatusCode := 5;
	ELSE
		BarrierCalibrationStatusCode := 4;
	END_IF
END_IF

IF NOT GuiReorientationControlActive AND PairedSecondBarrierFalling[1] AND Array1Active AND (State <= 2) THEN
	Array1TriggerPending := TRUE;
END_IF

IF NOT GuiReorientationControlActive AND PairedSecondBarrierFalling[2] AND Array2Active AND (State2 = 2) THEN
	Array2TriggerPending := TRUE;
END_IF

IF NOT GuiReorientationControlActive AND PairedSecondBarrierFalling[3] AND Array3Active AND (State3 <= 2) THEN
	Array3TriggerPending := TRUE;
END_IF

IF NOT GuiReorientationControlActive AND PairedSecondBarrierFalling[4] AND Array4Active AND (State4 = 2) THEN
	Array4TriggerPending := TRUE;
END_IF

// Measure the selected force-sensor peak relative to a debounced light-barrier edge.
IF GuiForceDelayLightBarrier = 2 THEN
	ForceDelayTrigger := PairedSecondBarrierFalling[1];
ELSIF GuiForceDelayLightBarrier = 4 THEN
	ForceDelayTrigger := PairedSecondBarrierFalling[2];
ELSIF GuiForceDelayLightBarrier = 6 THEN
	ForceDelayTrigger := PairedSecondBarrierFalling[3];
ELSE
	ForceDelayTrigger := PairedSecondBarrierFalling[4];
END_IF

IF GuiForceDelaySensor = 2 THEN
	ForceDelayCurrentSignal := NozzlePressure2;
ELSE
	ForceDelayCurrentSignal := NozzlePressure;
END_IF

IF GuiForceDelayReset THEN
	ForceDelayBusy := FALSE;
	ForceDelayResultCounter := 0;
	ForceDelayValidCount := 0;
	ForceDelayInvalidCount := 0;
	ForceDelayLastValid := FALSE;
	ForceDelayLightBarrierTimeMs := 0;
	ForceDelayPeakTimeMs := 0;
	ForceDelayPeakDelayMs := 0;
	ForceDelayElapsedMs := 0;
	ForceDelayBaseline := 0.0;
	ForceDelayPeak := 0.0;
	ForceDelayPeakRise := 0.0;
	GuiForceDelayReset := FALSE;
END_IF

IF NOT GuiForceDelayMeasurementEnabled THEN
	ForceDelayBusy := FALSE;
	ForceDelayStatusCode := 0;
ELSE
	IF GuiForceDelayWindowMs < 100 THEN
		GuiForceDelayWindowMs := 100;
	ELSIF GuiForceDelayWindowMs > 30000 THEN
		GuiForceDelayWindowMs := 30000;
	END_IF
	IF GuiForceDelayMinRise < 0.0 THEN
		GuiForceDelayMinRise := 0.0;
	END_IF

	IF ForceDelayBusy THEN
		IF ForceDelayElapsedMs < 30000 THEN
			ForceDelayElapsedMs := ForceDelayElapsedMs + 1;
		END_IF
		IF ForceDelayCurrentSignal > ForceDelayPeak THEN
			ForceDelayPeak := ForceDelayCurrentSignal;
			ForceDelayPeakDelayMs := UINT_TO_UDINT(ForceDelayElapsedMs);
		END_IF
		IF ForceDelayElapsedMs >= GuiForceDelayWindowMs THEN
			ForceDelayPeakRise := ForceDelayPeak - ForceDelayBaseline;
			ForceDelayPeakTimeMs := ForceDelayLightBarrierTimeMs + ForceDelayPeakDelayMs;
			ForceDelayLastValid := ForceDelayPeakRise >= GuiForceDelayMinRise;
			ForceDelayResultCounter := ForceDelayResultCounter + 1;
			IF ForceDelayLastValid THEN
				ForceDelayValidCount := ForceDelayValidCount + 1;
				ForceDelayStatusCode := 3;
			ELSE
				ForceDelayInvalidCount := ForceDelayInvalidCount + 1;
				ForceDelayStatusCode := 4;
			END_IF
			ForceDelayBusy := FALSE;
		END_IF
	ELSIF ForceDelayTrigger THEN
		IF ForceDelayBaselineCount > 0 THEN
			IF GuiForceDelaySensor = 2 THEN
				ForceDelayBaseline := ForceDelayBaselineSum2 / UINT_TO_REAL(ForceDelayBaselineCount);
			ELSE
				ForceDelayBaseline := ForceDelayBaselineSum1 / UINT_TO_REAL(ForceDelayBaselineCount);
			END_IF
		ELSE
			ForceDelayBaseline := ForceDelayCurrentSignal;
		END_IF
		ForceDelayLightBarrierTimeMs := LightBarrierEventClockMs;
		ForceDelayPeak := ForceDelayCurrentSignal;
		ForceDelayPeakRise := 0.0;
		ForceDelayPeakDelayMs := 0;
		ForceDelayElapsedMs := 0;
		ForceDelayBusy := TRUE;
		ForceDelayStatusCode := 2;
	ELSIF (ForceDelayStatusCode = 0) OR (ForceDelayStatusCode = 2) THEN
		ForceDelayStatusCode := 1;
	END_IF
END_IF

// Keep a 50 ms pre-trigger baseline for both analogue channels.
IF NOT ForceDelayBusy THEN
	ForceDelayBaselineSum1 := ForceDelayBaselineSum1 - ForceDelayBaselineBuffer1[ForceDelayBaselineIndex];
	ForceDelayBaselineSum2 := ForceDelayBaselineSum2 - ForceDelayBaselineBuffer2[ForceDelayBaselineIndex];
	ForceDelayBaselineBuffer1[ForceDelayBaselineIndex] := NozzlePressure;
	ForceDelayBaselineBuffer2[ForceDelayBaselineIndex] := NozzlePressure2;
	ForceDelayBaselineSum1 := ForceDelayBaselineSum1 + NozzlePressure;
	ForceDelayBaselineSum2 := ForceDelayBaselineSum2 + NozzlePressure2;
	IF ForceDelayBaselineCount < 50 THEN
		ForceDelayBaselineCount := ForceDelayBaselineCount + 1;
	END_IF
	IF ForceDelayBaselineIndex >= 49 THEN
		ForceDelayBaselineIndex := 0;
	ELSE
		ForceDelayBaselineIndex := ForceDelayBaselineIndex + 1;
	END_IF
END_IF

// Falling edge on light barrier 1 starts the velocity timing window.
IF PairedFirstBarrierFalling[1] THEN
	VelocityTimingActive := FALSE;
	VelocityTimer(IN := FALSE, PT := T#30S);
	VelocityTimingActive := TRUE;
	VelocityMeasurementValid := FALSE;
	EstimatedVelocityMmPerSec := 0.0;
	EstimatedVelocityMmPerSec1 := 0.0;
	EstimatedOffsetDelayMs1 := 0.0;
	OffsetDelayCycles1 := 0;
END_IF

// Light barriers 1 and 2 measure velocity for nozzle array 1.
// Light barrier 2 is also the physical trigger for nozzle array 1.
IF PairedSecondBarrierFalling[1] THEN
	IF VelocityTimingActive AND (TIME_TO_INT(VelocityTimer.ET) > 0) AND (GuiSensorSpacing12Mm > 0.0) THEN
		LastVelocityTimeMs := TIME_TO_INT(VelocityTimer.ET);
		EstimatedVelocityMmPerSec := GuiSensorSpacing12Mm * 1000.0 / TO_REAL(LastVelocityTimeMs);
		EstimatedVelocityMmPerSec1 := EstimatedVelocityMmPerSec;
		VelocityMeasurementValid := TRUE;
	END_IF
	VelocityTimingActive := FALSE;
END_IF

// Light barriers 3 and 4 measure velocity for nozzle array 2.
IF PairedFirstBarrierFalling[2] THEN
	VelocityTiming2Active := FALSE;
	VelocityTimer2(IN := FALSE, PT := T#30S);
	VelocityTiming2Active := TRUE;
	VelocityMeasurement2Valid := FALSE;
	EstimatedVelocityMmPerSec2 := 0.0;
	EstimatedOffsetDelayMs2 := 0.0;
	OffsetDelayCycles2 := 0;
END_IF

// Light barrier 4 completes the array 2 velocity measurement and triggers array 2.
IF PairedSecondBarrierFalling[2] THEN
	IF VelocityTiming2Active AND (TIME_TO_INT(VelocityTimer2.ET) > 0) AND (GuiSensorSpacing34Mm > 0.0) THEN
		LastVelocityTime2Ms := TIME_TO_INT(VelocityTimer2.ET);
		EstimatedVelocityMmPerSec2 := GuiSensorSpacing34Mm * 1000.0 / TO_REAL(LastVelocityTime2Ms);
		VelocityMeasurement2Valid := TRUE;
	END_IF
	VelocityTiming2Active := FALSE;
END_IF

// Light barriers 5 and 6 measure velocity for nozzle array 3.
IF PairedFirstBarrierFalling[3] THEN
	VelocityTiming3Active := FALSE;
	VelocityTimer3(IN := FALSE, PT := T#30S);
	VelocityTiming3Active := TRUE;
	VelocityMeasurement3Valid := FALSE;
	EstimatedVelocityMmPerSec3 := 0.0;
	EstimatedOffsetDelayMs3 := 0.0;
	OffsetDelayCycles3 := 0;
END_IF

// Light barrier 6 completes the array 3 velocity measurement and triggers array 3.
IF PairedSecondBarrierFalling[3] THEN
	IF VelocityTiming3Active AND (TIME_TO_INT(VelocityTimer3.ET) > 0) AND (GuiSensorSpacing56Mm > 0.0) THEN
		LastVelocityTime3Ms := TIME_TO_INT(VelocityTimer3.ET);
		EstimatedVelocityMmPerSec3 := GuiSensorSpacing56Mm * 1000.0 / TO_REAL(LastVelocityTime3Ms);
		VelocityMeasurement3Valid := TRUE;
	END_IF
	VelocityTiming3Active := FALSE;
END_IF

// Light barriers 7 and 8 measure velocity for nozzle array 4.
IF PairedFirstBarrierFalling[4] THEN
	VelocityTiming4Active := FALSE;
	VelocityTimer4(IN := FALSE, PT := T#30S);
	VelocityTiming4Active := TRUE;
	VelocityMeasurement4Valid := FALSE;
	EstimatedVelocityMmPerSec4 := 0.0;
	EstimatedOffsetDelayMs4 := 0.0;
	OffsetDelayCycles4 := 0;
END_IF

// Light barrier 8 completes the array 4 velocity measurement and triggers array 4.
IF PairedSecondBarrierFalling[4] THEN
	IF VelocityTiming4Active AND (TIME_TO_INT(VelocityTimer4.ET) > 0) AND (GuiSensorSpacing78Mm > 0.0) THEN
		LastVelocityTime4Ms := TIME_TO_INT(VelocityTimer4.ET);
		EstimatedVelocityMmPerSec4 := GuiSensorSpacing78Mm * 1000.0 / TO_REAL(LastVelocityTime4Ms);
		VelocityMeasurement4Valid := TRUE;
	END_IF
	VelocityTiming4Active := FALSE;
END_IF

IF GuiPressureMbar1 < 0 THEN
	PresValueV02 := 0;
ELSIF GuiPressureMbar1 > 6000 THEN
	PresValueV02 := 6000;
ELSE
	PresValueV02 := GuiPressureMbar1;
END_IF

IF GuiPressureMbar2 < 0 THEN
	PresValueV04 := 0;
ELSIF GuiPressureMbar2 > 6000 THEN
	PresValueV04 := 6000;
ELSE
	PresValueV04 := GuiPressureMbar2;
END_IF

IF GuiPressureMbar3 < 0 THEN
	PresValueV12 := 0;
ELSIF GuiPressureMbar3 > 6000 THEN
	PresValueV12 := 6000;
ELSE
	PresValueV12 := GuiPressureMbar3;
END_IF

IF GuiPressureMbar4 < 0 THEN
	PresValueV14 := 0;
ELSIF GuiPressureMbar4 > 6000 THEN
	PresValueV14 := 6000;
ELSE
	PresValueV14 := GuiPressureMbar4;
END_IF

IF GuiPulseDurationMs1 < 1 THEN
	ShotDurationCycles := 1;
ELSIF GuiPulseDurationMs1 > 500 THEN
	ShotDurationCycles := 500;
ELSE
	ShotDurationCycles := UINT_TO_INT(GuiPulseDurationMs1);
END_IF

IF GuiPulseDurationMs2 < 1 THEN
	ShotDurationCycles2 := 1;
ELSIF GuiPulseDurationMs2 > 500 THEN
	ShotDurationCycles2 := 500;
ELSE
	ShotDurationCycles2 := UINT_TO_INT(GuiPulseDurationMs2);
END_IF

IF GuiPulseDurationMs3 < 1 THEN
	ShotDurationCycles3 := 1;
ELSIF GuiPulseDurationMs3 > 500 THEN
	ShotDurationCycles3 := 500;
ELSE
	ShotDurationCycles3 := UINT_TO_INT(GuiPulseDurationMs3);
END_IF

IF GuiPulseDurationMs4 < 1 THEN
	ShotDurationCycles4 := 1;
ELSIF GuiPulseDurationMs4 > 500 THEN
	ShotDurationCycles4 := 500;
ELSE
	ShotDurationCycles4 := UINT_TO_INT(GuiPulseDurationMs4);
END_IF

IF GuiDelayMs1 > 1000 THEN
	DelayDurationCycles := 1000;
ELSE
	DelayDurationCycles := UINT_TO_INT(GuiDelayMs1);
END_IF

IF GuiDelayMs2 > 1000 THEN
	DelayDurationCycles2 := 1000;
ELSE
	DelayDurationCycles2 := UINT_TO_INT(GuiDelayMs2);
END_IF

IF GuiDelayMs3 > 1000 THEN
	DelayDurationCycles3 := 1000;
ELSE
	DelayDurationCycles3 := UINT_TO_INT(GuiDelayMs3);
END_IF

IF GuiDelayMs4 > 1000 THEN
	DelayDurationCycles4 := 1000;
ELSE
	DelayDurationCycles4 := UINT_TO_INT(GuiDelayMs4);
END_IF

IF GuiForceResponseDelayMs1 < 0.0 THEN
	GuiForceResponseDelayMs1 := 0.0;
ELSIF GuiForceResponseDelayMs1 > 1000.0 THEN
	GuiForceResponseDelayMs1 := 1000.0;
END_IF
IF GuiForceResponseDelayMs2 < 0.0 THEN
	GuiForceResponseDelayMs2 := 0.0;
ELSIF GuiForceResponseDelayMs2 > 1000.0 THEN
	GuiForceResponseDelayMs2 := 1000.0;
END_IF
IF GuiForceResponseDelayMs3 < 0.0 THEN
	GuiForceResponseDelayMs3 := 0.0;
ELSIF GuiForceResponseDelayMs3 > 1000.0 THEN
	GuiForceResponseDelayMs3 := 1000.0;
END_IF
IF GuiForceResponseDelayMs4 < 0.0 THEN
	GuiForceResponseDelayMs4 := 0.0;
ELSIF GuiForceResponseDelayMs4 > 1000.0 THEN
	GuiForceResponseDelayMs4 := 1000.0;
END_IF

IF GuiForceSingleNozzleResponseDelayMs1 < 0.0 THEN
	GuiForceSingleNozzleResponseDelayMs1 := 0.0;
ELSIF GuiForceSingleNozzleResponseDelayMs1 > 1000.0 THEN
	GuiForceSingleNozzleResponseDelayMs1 := 1000.0;
END_IF
IF GuiForceSingleNozzleResponseDelayMs2 < 0.0 THEN
	GuiForceSingleNozzleResponseDelayMs2 := 0.0;
ELSIF GuiForceSingleNozzleResponseDelayMs2 > 1000.0 THEN
	GuiForceSingleNozzleResponseDelayMs2 := 1000.0;
END_IF
IF GuiForceSingleNozzleResponseDelayMs3 < 0.0 THEN
	GuiForceSingleNozzleResponseDelayMs3 := 0.0;
ELSIF GuiForceSingleNozzleResponseDelayMs3 > 1000.0 THEN
	GuiForceSingleNozzleResponseDelayMs3 := 1000.0;
END_IF
IF GuiForceSingleNozzleResponseDelayMs4 < 0.0 THEN
	GuiForceSingleNozzleResponseDelayMs4 := 0.0;
ELSIF GuiForceSingleNozzleResponseDelayMs4 > 1000.0 THEN
	GuiForceSingleNozzleResponseDelayMs4 := 1000.0;
END_IF

// Interpolate the measured response delay from one to four enabled nozzles.
ActiveNozzleCount1 := 0;
IF GuiNozzleEnabled1 THEN ActiveNozzleCount1 := ActiveNozzleCount1 + 1; END_IF
IF GuiNozzleEnabled2 THEN ActiveNozzleCount1 := ActiveNozzleCount1 + 1; END_IF
IF GuiNozzleEnabled3 THEN ActiveNozzleCount1 := ActiveNozzleCount1 + 1; END_IF
IF GuiNozzleEnabled4 THEN ActiveNozzleCount1 := ActiveNozzleCount1 + 1; END_IF
IF GuiNozzleEnabled5 THEN ActiveNozzleCount1 := ActiveNozzleCount1 + 1; END_IF
IF GuiNozzleEnabled6 THEN ActiveNozzleCount1 := ActiveNozzleCount1 + 1; END_IF
ActiveNozzleCount2 := 0;
IF GuiNozzleEnabled7 THEN ActiveNozzleCount2 := ActiveNozzleCount2 + 1; END_IF
IF GuiNozzleEnabled8 THEN ActiveNozzleCount2 := ActiveNozzleCount2 + 1; END_IF
IF GuiNozzleEnabled9 THEN ActiveNozzleCount2 := ActiveNozzleCount2 + 1; END_IF
IF GuiNozzleEnabled10 THEN ActiveNozzleCount2 := ActiveNozzleCount2 + 1; END_IF
IF GuiNozzleEnabled11 THEN ActiveNozzleCount2 := ActiveNozzleCount2 + 1; END_IF
IF GuiNozzleEnabled12 THEN ActiveNozzleCount2 := ActiveNozzleCount2 + 1; END_IF
ActiveNozzleCount3 := 0;
IF GuiNozzleEnabled13 THEN ActiveNozzleCount3 := ActiveNozzleCount3 + 1; END_IF
IF GuiNozzleEnabled14 THEN ActiveNozzleCount3 := ActiveNozzleCount3 + 1; END_IF
IF GuiNozzleEnabled15 THEN ActiveNozzleCount3 := ActiveNozzleCount3 + 1; END_IF
IF GuiNozzleEnabled16 THEN ActiveNozzleCount3 := ActiveNozzleCount3 + 1; END_IF
IF GuiNozzleEnabled17 THEN ActiveNozzleCount3 := ActiveNozzleCount3 + 1; END_IF
IF GuiNozzleEnabled18 THEN ActiveNozzleCount3 := ActiveNozzleCount3 + 1; END_IF
ActiveNozzleCount4 := 0;
IF GuiNozzleEnabled19 THEN ActiveNozzleCount4 := ActiveNozzleCount4 + 1; END_IF
IF GuiNozzleEnabled20 THEN ActiveNozzleCount4 := ActiveNozzleCount4 + 1; END_IF
IF GuiNozzleEnabled21 THEN ActiveNozzleCount4 := ActiveNozzleCount4 + 1; END_IF
IF GuiNozzleEnabled22 THEN ActiveNozzleCount4 := ActiveNozzleCount4 + 1; END_IF
IF GuiNozzleEnabled23 THEN ActiveNozzleCount4 := ActiveNozzleCount4 + 1; END_IF
IF GuiNozzleEnabled24 THEN ActiveNozzleCount4 := ActiveNozzleCount4 + 1; END_IF

IF ActiveNozzleCount1 <= 1 THEN
	EffectiveForceResponseDelayMs1 := GuiForceSingleNozzleResponseDelayMs1;
ELSIF ActiveNozzleCount1 >= 4 THEN
	EffectiveForceResponseDelayMs1 := GuiForceResponseDelayMs1;
ELSE
	EffectiveForceResponseDelayMs1 := GuiForceSingleNozzleResponseDelayMs1
		+ (GuiForceResponseDelayMs1 - GuiForceSingleNozzleResponseDelayMs1)
		* TO_REAL(ActiveNozzleCount1 - 1) / 3.0;
END_IF
IF ActiveNozzleCount2 <= 1 THEN
	EffectiveForceResponseDelayMs2 := GuiForceSingleNozzleResponseDelayMs2;
ELSIF ActiveNozzleCount2 >= 4 THEN
	EffectiveForceResponseDelayMs2 := GuiForceResponseDelayMs2;
ELSE
	EffectiveForceResponseDelayMs2 := GuiForceSingleNozzleResponseDelayMs2
		+ (GuiForceResponseDelayMs2 - GuiForceSingleNozzleResponseDelayMs2)
		* TO_REAL(ActiveNozzleCount2 - 1) / 3.0;
END_IF
IF ActiveNozzleCount3 <= 1 THEN
	EffectiveForceResponseDelayMs3 := GuiForceSingleNozzleResponseDelayMs3;
ELSIF ActiveNozzleCount3 >= 4 THEN
	EffectiveForceResponseDelayMs3 := GuiForceResponseDelayMs3;
ELSE
	EffectiveForceResponseDelayMs3 := GuiForceSingleNozzleResponseDelayMs3
		+ (GuiForceResponseDelayMs3 - GuiForceSingleNozzleResponseDelayMs3)
		* TO_REAL(ActiveNozzleCount3 - 1) / 3.0;
END_IF
IF ActiveNozzleCount4 <= 1 THEN
	EffectiveForceResponseDelayMs4 := GuiForceSingleNozzleResponseDelayMs4;
ELSIF ActiveNozzleCount4 >= 4 THEN
	EffectiveForceResponseDelayMs4 := GuiForceResponseDelayMs4;
ELSE
	EffectiveForceResponseDelayMs4 := GuiForceSingleNozzleResponseDelayMs4
		+ (GuiForceResponseDelayMs4 - GuiForceSingleNozzleResponseDelayMs4)
		* TO_REAL(ActiveNozzleCount4 - 1) / 3.0;
END_IF

IF VelocityMeasurementValid AND (EstimatedVelocityMmPerSec1 > 0.0) THEN
	IF GuiOffsetMm1 < 0.0 THEN
		EstimatedOffsetDelayMs1 := 0.0;
	ELSE
		EstimatedOffsetDelayMs1 := (GuiOffsetMm1 * 1000.0 / EstimatedVelocityMmPerSec1) - EffectiveForceResponseDelayMs1;
		IF EstimatedOffsetDelayMs1 < 0.0 THEN
			EstimatedOffsetDelayMs1 := 0.0;
		END_IF
	END_IF
ELSE
	EstimatedOffsetDelayMs1 := 0.0;
END_IF

IF VelocityMeasurement2Valid AND (EstimatedVelocityMmPerSec2 > 0.0) THEN
	IF GuiOffsetMm2 < 0.0 THEN
		EstimatedOffsetDelayMs2 := 0.0;
	ELSE
		EstimatedOffsetDelayMs2 := (GuiOffsetMm2 * 1000.0 / EstimatedVelocityMmPerSec2) - EffectiveForceResponseDelayMs2;
		IF EstimatedOffsetDelayMs2 < 0.0 THEN
			EstimatedOffsetDelayMs2 := 0.0;
		END_IF
	END_IF
ELSE
	EstimatedOffsetDelayMs2 := 0.0;
END_IF

IF VelocityMeasurement3Valid AND (EstimatedVelocityMmPerSec3 > 0.0) THEN
	IF GuiOffsetMm3 < 0.0 THEN
		EstimatedOffsetDelayMs3 := 0.0;
	ELSE
		EstimatedOffsetDelayMs3 := (GuiOffsetMm3 * 1000.0 / EstimatedVelocityMmPerSec3) - EffectiveForceResponseDelayMs3;
		IF EstimatedOffsetDelayMs3 < 0.0 THEN
			EstimatedOffsetDelayMs3 := 0.0;
		END_IF
	END_IF
ELSE
	EstimatedOffsetDelayMs3 := 0.0;
END_IF

IF VelocityMeasurement4Valid AND (EstimatedVelocityMmPerSec4 > 0.0) THEN
	IF GuiOffsetMm4 < 0.0 THEN
		EstimatedOffsetDelayMs4 := 0.0;
	ELSE
		EstimatedOffsetDelayMs4 := (GuiOffsetMm4 * 1000.0 / EstimatedVelocityMmPerSec4) - EffectiveForceResponseDelayMs4;
		IF EstimatedOffsetDelayMs4 < 0.0 THEN
			EstimatedOffsetDelayMs4 := 0.0;
		END_IF
	END_IF
ELSE
	EstimatedOffsetDelayMs4 := 0.0;
END_IF

IF EstimatedOffsetDelayMs1 > 30000.0 THEN
	OffsetDelayCycles1 := 30000;
ELSE
	OffsetDelayCycles1 := REAL_TO_INT(EstimatedOffsetDelayMs1);
END_IF

IF EstimatedOffsetDelayMs2 > 30000.0 THEN
	OffsetDelayCycles2 := 30000;
ELSE
	OffsetDelayCycles2 := REAL_TO_INT(EstimatedOffsetDelayMs2);
END_IF

IF EstimatedOffsetDelayMs3 > 30000.0 THEN
	OffsetDelayCycles3 := 30000;
ELSE
	OffsetDelayCycles3 := REAL_TO_INT(EstimatedOffsetDelayMs3);
END_IF

IF EstimatedOffsetDelayMs4 > 30000.0 THEN
	OffsetDelayCycles4 := 30000;
ELSE
	OffsetDelayCycles4 := REAL_TO_INT(EstimatedOffsetDelayMs4);
END_IF

DelayDurationCycles := DelayDurationCycles + OffsetDelayCycles1;
DelayDurationCycles2 := DelayDurationCycles2 + OffsetDelayCycles2;
DelayDurationCycles3 := DelayDurationCycles3 + OffsetDelayCycles3;
DelayDurationCycles4 := DelayDurationCycles4 + OffsetDelayCycles4;

CASE State OF
	0:
		Enable0 := TRUE;
		Acknowledge0 := FALSE;
		State := State + 1;
		
	1:
		Enable0 := TRUE;
		Acknowledge0 := TRUE;
		State := State + 1;
	2:
		//start nozzle array 1 on the falling edge of light barrier 2
		IF NOT Array1Active THEN
			Array1TriggerPending := FALSE;
		ELSIF Array1TriggerPending THEN
			Array1TriggerPending := FALSE;
			Counter := 0;
			LatchedDelayCycles1 := DelayDurationCycles;
			LatchedNozzleEndCycles1 := DelayDurationCycles + ShotDurationCycles;
			PressureSum := 0.0;
			PressureSum1 := 0.0;
			PressureSum2 := 0.0;
			PressurePoints := 0;
			PressurePoints1 := 0;
			PressurePoints2 := 0;
			State := State + 1;
		END_IF
	3:
		IF NOT Array1Active THEN
			OpenValve1 := FALSE;
			OpenValve2 := FALSE;
			OpenValve3 := FALSE;
			OpenValve4 := FALSE;
			OpenValve17 := FALSE;
			OpenValve18 := FALSE;
			Counter := 0;
			State := 2;
		ELSE
			Counter := Counter + 1;
			OpenValve1 := GuiArrayEnabled1 AND GuiNozzleEnabled1 AND (Counter > LatchedDelayCycles1) AND (Counter <= LatchedNozzleEndCycles1);
			OpenValve2 := GuiArrayEnabled1 AND GuiNozzleEnabled2 AND (Counter > LatchedDelayCycles1) AND (Counter <= LatchedNozzleEndCycles1);
			OpenValve3 := GuiArrayEnabled1 AND GuiNozzleEnabled3 AND (Counter > LatchedDelayCycles1) AND (Counter <= LatchedNozzleEndCycles1);
			OpenValve4 := GuiArrayEnabled1 AND GuiNozzleEnabled4 AND (Counter > LatchedDelayCycles1) AND (Counter <= LatchedNozzleEndCycles1);
			OpenValve17 := GuiArrayEnabled1 AND GuiNozzleEnabled5 AND (Counter > LatchedDelayCycles1) AND (Counter <= LatchedNozzleEndCycles1);
			OpenValve18 := GuiArrayEnabled1 AND GuiNozzleEnabled6 AND (Counter > LatchedDelayCycles1) AND (Counter <= LatchedNozzleEndCycles1);
			IF GuiReorientationControlActive AND (BatchActiveSequence[1] > 0)
				AND (OpenValve1 OR OpenValve2 OR OpenValve3 OR OpenValve4 OR OpenValve17 OR OpenValve18) THEN
				BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[1] - 1) MOD 128);
				BatchQueueActuatedMask[BatchSlotIndex] := BatchQueueActuatedMask[BatchSlotIndex] OR BYTE#1;
			END_IF

			IF OpenValve1 OR OpenValve2 OR OpenValve3 OR OpenValve4 OR OpenValve17 OR OpenValve18 THEN
				PressureSum := PressureSum + NozzlePressure;
				PressureSum1 := PressureSum1 + NozzlePressure;
				PressurePoints := PressurePoints + 1;
				PressurePoints1 := PressurePoints1 + 1;
				IF PressurePoints1 <= 1000 THEN
					N1PressureValues[PressurePoints1] := NozzlePressure;
				END_IF
				PressureSum := PressureSum + NozzlePressure2;
				PressureSum2 := PressureSum2 + NozzlePressure2;
				PressurePoints := PressurePoints + 1;
				PressurePoints2 := PressurePoints2 + 1;
				IF PressurePoints2 <= 1000 THEN
					N2PressureValues[PressurePoints2] := NozzlePressure2;
				END_IF
			END_IF

			IF Counter > LatchedNozzleEndCycles1 THEN
				OpenValve1 := FALSE;
				OpenValve2 := FALSE;
				OpenValve3 := FALSE;
				OpenValve4 := FALSE;
				OpenValve17 := FALSE;
				OpenValve18 := FALSE;

				IF PressurePoints > 0 THEN
					AvgPressure := PressureSum / TO_REAL(PressurePoints);
					IF PressurePoints1 > 0 THEN
						AvgPressureN1 := PressureSum1 / TO_REAL(PressurePoints1);
					ELSE
						AvgPressureN1 := 0.0;
					END_IF
					IF PressurePoints2 > 0 THEN
						AvgPressureN2 := PressureSum2 / TO_REAL(PressurePoints2);
					ELSE
						AvgPressureN2 := 0.0;
					END_IF
					ShotCounter := ShotCounter + 1;
					LogPressureTrigger := TRUE;
				END_IF
				IF GuiReorientationControlActive AND (BatchActiveSequence[1] > 0) THEN
					BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[1] - 1) MOD 128);
					BatchQueueFinishedMask[BatchSlotIndex] := BatchQueueFinishedMask[BatchSlotIndex] OR BYTE#1;
					BatchActiveSequence[1] := 0;
					GuiArrayEnabled1 := FALSE;
				END_IF

				Counter := 0;
				State := 2;
			END_IF
		END_IF
		
	6:
		Enable0 := FALSE;
		Acknowledge0 := FALSE;
		OpenValve1 := FALSE;
		OpenValve2 := FALSE;
		OpenValve3 := FALSE;
		OpenValve4 := FALSE;
		OpenValve17 := FALSE;
		OpenValve18 := FALSE;
END_CASE

CASE State2 OF
	2:
		//start nozzle array 2 on the falling edge of light barrier 4
		IF NOT Array2Active THEN
			Array2TriggerPending := FALSE;
		ELSIF Array2TriggerPending THEN
			Array2TriggerPending := FALSE;
			Counter2 := 0;
			LatchedDelayCycles2 := DelayDurationCycles2;
			LatchedNozzleEndCycles2 := DelayDurationCycles2 + ShotDurationCycles2;
			State2 := State2 + 1;
		END_IF
	3:
		IF NOT Array2Active THEN
			OpenValve5 := FALSE;
			OpenValve6 := FALSE;
			OpenValve7 := FALSE;
			OpenValve8 := FALSE;
			OpenValve19 := FALSE;
			OpenValve20 := FALSE;
			Counter2 := 0;
			State2 := 2;
		ELSE
			Counter2 := Counter2 + 1;
			OpenValve5 := GuiArrayEnabled2 AND GuiNozzleEnabled7 AND (Counter2 > LatchedDelayCycles2) AND (Counter2 <= LatchedNozzleEndCycles2);
			OpenValve6 := GuiArrayEnabled2 AND GuiNozzleEnabled8 AND (Counter2 > LatchedDelayCycles2) AND (Counter2 <= LatchedNozzleEndCycles2);
			OpenValve7 := GuiArrayEnabled2 AND GuiNozzleEnabled9 AND (Counter2 > LatchedDelayCycles2) AND (Counter2 <= LatchedNozzleEndCycles2);
			OpenValve8 := GuiArrayEnabled2 AND GuiNozzleEnabled10 AND (Counter2 > LatchedDelayCycles2) AND (Counter2 <= LatchedNozzleEndCycles2);
			OpenValve19 := GuiArrayEnabled2 AND GuiNozzleEnabled11 AND (Counter2 > LatchedDelayCycles2) AND (Counter2 <= LatchedNozzleEndCycles2);
			OpenValve20 := GuiArrayEnabled2 AND GuiNozzleEnabled12 AND (Counter2 > LatchedDelayCycles2) AND (Counter2 <= LatchedNozzleEndCycles2);
			IF GuiReorientationControlActive AND (BatchActiveSequence[2] > 0)
				AND (OpenValve5 OR OpenValve6 OR OpenValve7 OR OpenValve8 OR OpenValve19 OR OpenValve20) THEN
				BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[2] - 1) MOD 128);
				BatchQueueActuatedMask[BatchSlotIndex] := BatchQueueActuatedMask[BatchSlotIndex] OR BYTE#2;
			END_IF

			IF Counter2 > LatchedNozzleEndCycles2 THEN
				OpenValve5 := FALSE;
				OpenValve6 := FALSE;
				OpenValve7 := FALSE;
				OpenValve8 := FALSE;
				OpenValve19 := FALSE;
				OpenValve20 := FALSE;
				IF GuiReorientationControlActive AND (BatchActiveSequence[2] > 0) THEN
					BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[2] - 1) MOD 128);
					BatchQueueFinishedMask[BatchSlotIndex] := BatchQueueFinishedMask[BatchSlotIndex] OR BYTE#2;
					BatchActiveSequence[2] := 0;
					GuiArrayEnabled2 := FALSE;
				END_IF
				Counter2 := 0;
				State2 := 2;
			END_IF
		END_IF
END_CASE

CASE State3 OF
	0:
		Enable1 := TRUE;
		Acknowledge1 := FALSE;
		State3 := State3 + 1;

	1:
		Enable1 := TRUE;
		Acknowledge1 := TRUE;
		State3 := State3 + 1;

	2:
		//start nozzle array 3 on the falling edge of light barrier 6
		IF NOT Array3Active THEN
			Array3TriggerPending := FALSE;
		ELSIF Array3TriggerPending THEN
			Array3TriggerPending := FALSE;
			Counter3 := 0;
			LatchedDelayCycles3 := DelayDurationCycles3;
			LatchedNozzleEndCycles3 := DelayDurationCycles3 + ShotDurationCycles3;
			State3 := State3 + 1;
		END_IF

	3:
		IF NOT Array3Active THEN
			OpenValve9 := FALSE;
			OpenValve10 := FALSE;
			OpenValve11 := FALSE;
			OpenValve12 := FALSE;
			OpenValve21 := FALSE;
			OpenValve22 := FALSE;
			Counter3 := 0;
			State3 := 2;
		ELSE
			Counter3 := Counter3 + 1;
			OpenValve9 := GuiArrayEnabled3 AND GuiNozzleEnabled13 AND (Counter3 > LatchedDelayCycles3) AND (Counter3 <= LatchedNozzleEndCycles3);
			OpenValve10 := GuiArrayEnabled3 AND GuiNozzleEnabled14 AND (Counter3 > LatchedDelayCycles3) AND (Counter3 <= LatchedNozzleEndCycles3);
			OpenValve11 := GuiArrayEnabled3 AND GuiNozzleEnabled15 AND (Counter3 > LatchedDelayCycles3) AND (Counter3 <= LatchedNozzleEndCycles3);
			OpenValve12 := GuiArrayEnabled3 AND GuiNozzleEnabled16 AND (Counter3 > LatchedDelayCycles3) AND (Counter3 <= LatchedNozzleEndCycles3);
			OpenValve21 := GuiArrayEnabled3 AND GuiNozzleEnabled17 AND (Counter3 > LatchedDelayCycles3) AND (Counter3 <= LatchedNozzleEndCycles3);
			OpenValve22 := GuiArrayEnabled3 AND GuiNozzleEnabled18 AND (Counter3 > LatchedDelayCycles3) AND (Counter3 <= LatchedNozzleEndCycles3);
			IF GuiReorientationControlActive AND (BatchActiveSequence[3] > 0)
				AND (OpenValve9 OR OpenValve10 OR OpenValve11 OR OpenValve12 OR OpenValve21 OR OpenValve22) THEN
				BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[3] - 1) MOD 128);
				BatchQueueActuatedMask[BatchSlotIndex] := BatchQueueActuatedMask[BatchSlotIndex] OR BYTE#4;
			END_IF

			IF Counter3 > LatchedNozzleEndCycles3 THEN
				OpenValve9 := FALSE;
				OpenValve10 := FALSE;
				OpenValve11 := FALSE;
				OpenValve12 := FALSE;
				OpenValve21 := FALSE;
				OpenValve22 := FALSE;
				IF GuiReorientationControlActive AND (BatchActiveSequence[3] > 0) THEN
					BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[3] - 1) MOD 128);
					BatchQueueFinishedMask[BatchSlotIndex] := BatchQueueFinishedMask[BatchSlotIndex] OR BYTE#4;
					BatchActiveSequence[3] := 0;
					GuiArrayEnabled3 := FALSE;
				END_IF
				Counter3 := 0;
				State3 := 2;
			END_IF
		END_IF

	6:
		Enable1 := FALSE;
		Acknowledge1 := FALSE;
		OpenValve9 := FALSE;
		OpenValve10 := FALSE;
		OpenValve11 := FALSE;
		OpenValve12 := FALSE;
		OpenValve21 := FALSE;
		OpenValve22 := FALSE;
END_CASE

CASE State4 OF
	2:
		//start nozzle array 4 on the falling edge of light barrier 8
		IF NOT Array4Active THEN
			Array4TriggerPending := FALSE;
		ELSIF Array4TriggerPending THEN
			Array4TriggerPending := FALSE;
			Counter4 := 0;
			LatchedDelayCycles4 := DelayDurationCycles4;
			LatchedNozzleEndCycles4 := DelayDurationCycles4 + ShotDurationCycles4;
			State4 := State4 + 1;
		END_IF

	3:
		IF NOT Array4Active THEN
			OpenValve13 := FALSE;
			OpenValve14 := FALSE;
			OpenValve15 := FALSE;
			OpenValve16 := FALSE;
			OpenValve23 := FALSE;
			OpenValve24 := FALSE;
			Counter4 := 0;
			State4 := 2;
		ELSE
			Counter4 := Counter4 + 1;
			OpenValve13 := GuiArrayEnabled4 AND GuiNozzleEnabled19 AND (Counter4 > LatchedDelayCycles4) AND (Counter4 <= LatchedNozzleEndCycles4);
			OpenValve14 := GuiArrayEnabled4 AND GuiNozzleEnabled20 AND (Counter4 > LatchedDelayCycles4) AND (Counter4 <= LatchedNozzleEndCycles4);
			OpenValve15 := GuiArrayEnabled4 AND GuiNozzleEnabled21 AND (Counter4 > LatchedDelayCycles4) AND (Counter4 <= LatchedNozzleEndCycles4);
			OpenValve16 := GuiArrayEnabled4 AND GuiNozzleEnabled22 AND (Counter4 > LatchedDelayCycles4) AND (Counter4 <= LatchedNozzleEndCycles4);
			OpenValve23 := GuiArrayEnabled4 AND GuiNozzleEnabled23 AND (Counter4 > LatchedDelayCycles4) AND (Counter4 <= LatchedNozzleEndCycles4);
			OpenValve24 := GuiArrayEnabled4 AND GuiNozzleEnabled24 AND (Counter4 > LatchedDelayCycles4) AND (Counter4 <= LatchedNozzleEndCycles4);
			IF GuiReorientationControlActive AND (BatchActiveSequence[4] > 0)
				AND (OpenValve13 OR OpenValve14 OR OpenValve15 OR OpenValve16 OR OpenValve23 OR OpenValve24) THEN
				BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[4] - 1) MOD 128);
				BatchQueueActuatedMask[BatchSlotIndex] := BatchQueueActuatedMask[BatchSlotIndex] OR BYTE#8;
			END_IF

			IF Counter4 > LatchedNozzleEndCycles4 THEN
				OpenValve13 := FALSE;
				OpenValve14 := FALSE;
				OpenValve15 := FALSE;
				OpenValve16 := FALSE;
				OpenValve23 := FALSE;
				OpenValve24 := FALSE;
				IF GuiReorientationControlActive AND (BatchActiveSequence[4] > 0) THEN
					BatchSlotIndex := UDINT_TO_INT((BatchActiveSequence[4] - 1) MOD 128);
					BatchQueueFinishedMask[BatchSlotIndex] := BatchQueueFinishedMask[BatchSlotIndex] OR BYTE#8;
					BatchActiveSequence[4] := 0;
					GuiArrayEnabled4 := FALSE;
				END_IF
				Counter4 := 0;
				State4 := 2;
			END_IF
		END_IF
END_CASE

// Physical idle status covers the four active jobs and all queued array jobs.
ReorientationArraysIdle := (State = 2) AND (State2 = 2) AND (State3 = 2) AND (State4 = 2)
	AND NOT Array1TriggerPending AND NOT Array2TriggerPending AND NOT Array3TriggerPending AND NOT Array4TriggerPending
	AND (BatchJobCount[1] = 0) AND (BatchJobCount[2] = 0) AND (BatchJobCount[3] = 0) AND (BatchJobCount[4] = 0)
	AND (BatchActiveSequence[1] = 0) AND (BatchActiveSequence[2] = 0)
	AND (BatchActiveSequence[3] = 0) AND (BatchActiveSequence[4] = 0)
	AND NOT OpenValve1 AND NOT OpenValve2 AND NOT OpenValve3 AND NOT OpenValve4
	AND NOT OpenValve5 AND NOT OpenValve6 AND NOT OpenValve7 AND NOT OpenValve8
	AND NOT OpenValve9 AND NOT OpenValve10 AND NOT OpenValve11 AND NOT OpenValve12
	AND NOT OpenValve13 AND NOT OpenValve14 AND NOT OpenValve15 AND NOT OpenValve16
	AND NOT OpenValve17 AND NOT OpenValve18 AND NOT OpenValve19 AND NOT OpenValve20
	AND NOT OpenValve21 AND NOT OpenValve22 AND NOT OpenValve23 AND NOT OpenValve24;
// Complete records strictly in sequence.  LB8 may arrive before a delayed array
// pulse ends, therefore ExitSeen and all four finished bits are both required.
IF GuiReorientationControlActive AND ((ReorientationState = 20) OR (ReorientationState = 30))
	AND (BatchNextCompleteSequence <= ReorientationQueueEnqueueAck) THEN
	BatchSlotIndex := UDINT_TO_INT((BatchNextCompleteSequence - 1) MOD 128);
	IF BatchQueueExitSeen[BatchSlotIndex] AND (BatchQueueFinishedMask[BatchSlotIndex] = BYTE#15) THEN
		BatchResultSequence[BatchSlotIndex] := BatchQueueSequence[BatchSlotIndex];
		BatchResultTriggeredMask[BatchSlotIndex] := BatchQueueTriggeredMask[BatchSlotIndex];
		BatchResultFaultCode[BatchSlotIndex] := 0;
		ReorientationQueueCompletedCount := BatchNextCompleteSequence;
		ReorientationCycleCounter := ReorientationCycleCounter + 1;
		IF BatchQueueArrayMask[BatchSlotIndex] = BYTE#0 THEN
			ReorientationQueueBypassCount := ReorientationQueueBypassCount + 1;
		END_IF
		BatchNextCompleteSequence := BatchNextCompleteSequence + 1;
	END_IF
END_IF

// Result ring head. The GUI acknowledges only after its image/CSV export.
IF BatchAcceptedResultAck < ReorientationQueueCompletedCount THEN
	BatchSlotIndex := UDINT_TO_INT(BatchAcceptedResultAck MOD 128);
	ReorientationResultAvailable := TRUE;
	ReorientationResultSequence := BatchResultSequence[BatchSlotIndex];
	ReorientationResultTriggeredMask := BatchResultTriggeredMask[BatchSlotIndex];
	ReorientationResultFaultCode := BatchResultFaultCode[BatchSlotIndex];
ELSE
	ReorientationResultAvailable := FALSE;
END_IF

// A normal finish drains sensors, array FIFOs and exported results before the
// conveyor is stopped. No timeout is imposed on an intentionally long run.
IF GuiReorientationControlActive AND (ReorientationState = 30)
	AND (ReorientationQueueCompletedCount = ReorientationQueueEnqueueAck)
	AND (BatchAcceptedResultAck = ReorientationQueueCompletedCount)
	AND ReorientationArraysIdle THEN
	GuiConveyorEnabled := FALSE;
	ReorientationComplete := TRUE;
	ReorientationState := 40;
END_IF

ReorientationBusy := GuiReorientationControlActive AND (ReorientationState >= 10) AND (ReorientationState < 40);

// Hard close on abort/watchdog/timeout; retained profile values are harmless while
// the enables and conveyor permit remain latched off.
IF ReorientationSafeLatch THEN
	Counter := 0; Counter2 := 0; Counter3 := 0; Counter4 := 0;
	BatchJobCount[1] := 0; BatchJobCount[2] := 0; BatchJobCount[3] := 0; BatchJobCount[4] := 0;
	BatchActiveSequence[1] := 0; BatchActiveSequence[2] := 0;
	BatchActiveSequence[3] := 0; BatchActiveSequence[4] := 0;
	IF State = 3 THEN State := 2; END_IF
	IF State2 = 3 THEN State2 := 2; END_IF
	IF State3 = 3 THEN State3 := 2; END_IF
	IF State4 = 3 THEN State4 := 2; END_IF
	OpenValve1 := FALSE; OpenValve2 := FALSE; OpenValve3 := FALSE; OpenValve4 := FALSE;
	OpenValve5 := FALSE; OpenValve6 := FALSE; OpenValve7 := FALSE; OpenValve8 := FALSE;
	OpenValve9 := FALSE; OpenValve10 := FALSE; OpenValve11 := FALSE; OpenValve12 := FALSE;
	OpenValve13 := FALSE; OpenValve14 := FALSE; OpenValve15 := FALSE; OpenValve16 := FALSE;
	OpenValve17 := FALSE; OpenValve18 := FALSE; OpenValve19 := FALSE; OpenValve20 := FALSE;
	OpenValve21 := FALSE; OpenValve22 := FALSE; OpenValve23 := FALSE; OpenValve24 := FALSE;
END_IF

// Setup movement must never trigger a nozzle, even if a state was active on entry.
IF GuiConveyorCalibrationMode OR GuiVelocityCheckMode THEN
	Array1TriggerPending := FALSE;
	Array2TriggerPending := FALSE;
	Array3TriggerPending := FALSE;
	Array4TriggerPending := FALSE;
	Counter := 0;
	Counter2 := 0;
	Counter3 := 0;
	Counter4 := 0;
	IF State = 3 THEN State := 2; END_IF
	IF State2 = 3 THEN State2 := 2; END_IF
	IF State3 = 3 THEN State3 := 2; END_IF
	IF State4 = 3 THEN State4 := 2; END_IF
	OpenValve1 := FALSE;
	OpenValve2 := FALSE;
	OpenValve3 := FALSE;
	OpenValve4 := FALSE;
	OpenValve5 := FALSE;
	OpenValve6 := FALSE;
	OpenValve7 := FALSE;
	OpenValve8 := FALSE;
	OpenValve9 := FALSE;
	OpenValve10 := FALSE;
	OpenValve11 := FALSE;
	OpenValve12 := FALSE;
	OpenValve13 := FALSE;
	OpenValve14 := FALSE;
	OpenValve15 := FALSE;
	OpenValve16 := FALSE;
	OpenValve17 := FALSE;
	OpenValve18 := FALSE;
	OpenValve19 := FALSE;
	OpenValve20 := FALSE;
	OpenValve21 := FALSE;
	OpenValve22 := FALSE;
	OpenValve23 := FALSE;
	OpenValve24 := FALSE;
END_IF

FBValveControlV0(
	awBusDataFromVTEM:= Valve0_IN, 
	awBusDataToVTEM:= Valve0_OUT, 
	xEnable:= Enable0, 
	bySetValveMode:= ValveMode0, 
	bySetAppControl:= AppControl0, 
	bySetAppOption:= AppOption0, 
	iSetpointValue1:= PresValueV02, 
	iSetpointValue2:= PresValueV04, 
	xManualAcknowledge:= Acknowledge0, 
	byActualValveMode=> ActValveMode0, 
	byActualValveState=> ActValveState0, 
	byActualAppState=> ActAppState0, 
	iActualValue1=> ActPresValueV02, 
	iActualValue2=> ActPresValueV04, 
	iResponseToValveModeSet=> ResponseToValveModeSet0, 
	iErrorCode=> ErrorCode0);

FBValveControlV1(
	awBusDataFromVTEM:= Valve1_IN,
	awBusDataToVTEM:= Valve1_OUT,
	xEnable:= Enable1,
	bySetValveMode:= ValveMode1,
	bySetAppControl:= AppControl1,
	bySetAppOption:= AppOption1,
	iSetpointValue1:= PresValueV12,
	iSetpointValue2:= PresValueV14,
	xManualAcknowledge:= Acknowledge1,
	byActualValveMode=> ActValveMode1,
	byActualValveState=> ActValveState1,
	byActualAppState=> ActAppState1,
	iActualValue1=> ActPresValueV12,
	iActualValue2=> ActPresValueV14,
	iResponseToValveModeSet=> ResponseToValveModeSet1,
	iErrorCode=> ErrorCode1);

LastLightBarrier1 := LightBarrierStable1;
LastLightBarrier2 := LightBarrierStable2;
LastLightBarrier3 := LightBarrierStable3;
LastLightBarrier4 := LightBarrierStable4;
LastLightBarrier5 := LightBarrierStable5;
LastLightBarrier6 := LightBarrierStable6;
LastLightBarrier7 := LightBarrierStable7;
LastLightBarrier8 := LightBarrierStable8;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
